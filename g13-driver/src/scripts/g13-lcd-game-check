#!/usr/bin/env python3
"""Say whether an installed game will talk to the G13 screen, before you launch it.

A game drives a Logitech LCD one of three ways, and each needs a different answer from us:

  * the Logitech LCD SDK (LogitechLcd.dll, LogiLcdInit, LogiLcdMonoSetText, ...) - what this
    driver's shim implements, so copying the matching LogitechLcd.dll into the game's folder is all
    it takes;
  * the older LCD Manager API (lglcd.dll, lgLcdInit, lgLcdUpdateBitmap) - a different set of calls
    that the shim does not speak, so it would need a second shim;
  * the Logitech driver's device directly (LGVirHid) - a Windows device a game opens and writes to,
    which cannot be stood in for from outside Windows.

Reading a game's strings is enough to tell which, and it takes a second, which is a great deal
better than installing a game to find out. Packed executables (SecuROM and friends) can hide the
names - Dragon Age: Origins does - so "nothing found" means "nothing to be found this way", not a
certainty.

    g13-lcd-game-check ~/.steam/steam/steamapps/common/<game>
    g13-lcd-game-check --steam            every installed Steam game
"""
import os
import struct
import subprocess
import sys

#: The new SDK: what liblogitechlcd.so and LogitechLcd.dll implement.
SDK_NAMES = ("LogiLcdInit", "LogiLcdMonoSetText", "LogiLcdMonoSetBackground", "LogiLcdUpdate",
             "LogiLcdIsButtonPressed", "LogitechLcd.dll", "LogitechLcd")

#: The older LCD Manager API, which is a different conversation.
OLD_NAMES = ("lglcd.dll", "lgLcdInit", "lgLcdConnect", "lgLcdUpdateBitmap",
             "lgLcdSetAsLCDForegroundApp")

#: The Logitech driver's device, opened directly by a few games.
DEVICE_NAMES = ("LGVirHid", "LGDevice")

#: The LCD middleware that Dragon Age: Origins and The Witcher both compile in. Its presence says
#: the game was built to draw on an LCD, but not whose API it ends up calling: those two name no
#: Logitech library at all, which is what the "plugin" model looks like - Logitech's own software
#: does the talking, and there is nothing of theirs for a shim to stand in for.
MIDDLEWARE_NAMES = ("CLCDManager", "CEzLcd", "CLCDStreamingText", "EZ_LCD")

#: The other way round: a game whose own scripts carry an LCD helper. Borderlands 2 is this case -
#: its UnrealScript asks whether an LCD is connected and what to draw on it, while the native half
#: that would drive one is missing from its Linux port and present in its Windows build.
SCRIPT_NAMES = ("ULcdHelper", "LcdHelper")

#: Windows libraries and Linux ones: a game with a native Linux port is still worth judging, and
#: its binaries have no extension at all, so ELF files are found by their magic bytes.
INTERESTING = (".exe", ".dll", ".so")

#: Beyond this, a file is a runtime or a video rather than a game thinking about an LCD.
BIG = 200 * 1024 * 1024

#: What Steam installs for other games, not a game: the Proton runtimes.
NOT_A_GAME = ("Proton", "Steam Linux Runtime", "Steamworks")


def pe_architecture(path):
    """'32-bit' or '64-bit' for a Windows executable, or None if it is not one.

    Read straight from the header: a 32-bit game cannot load a 64-bit DLL at all, so which build
    belongs in that folder is decided here rather than by trying it.
    """
    try:
        with open(path, "rb") as handle:
            head = handle.read(64)
            if len(head) < 64 or head[:2] != b"MZ":
                return None
            offset = struct.unpack_from("<I", head, 0x3C)[0]
            handle.seek(offset)
            signature = handle.read(6)
    except OSError:
        return None
    if len(signature) < 6 or signature[:4] != b"PE\0\0":
        return None
    machine = struct.unpack_from("<H", signature, 4)[0]
    if machine == 0x014C:
        return "32-bit"
    if machine == 0x8664:
        return "64-bit"
    return None


def strings_of(path, wide=False):
    """The printable strings in a file, 8-bit or 16-bit, without needing to trust the file."""
    command = ["strings", "-a"] + (["-el"] if wide else []) + [path]
    try:
        result = subprocess.run(command, capture_output=True, text=True, timeout=120)
    except (OSError, subprocess.SubprocessError):
        return ""
    return result.stdout


def what_it_uses(path):
    """Which of the ways this file talks to a Logitech LCD, if any.

    Case is ignored, because a DLL is named whatever the linker felt like that day
    (`LogitechLCD.dll` and `LogitechLcd.dll` are the same file to Windows), and this driver's own
    shim is skipped: it is called LogitechLcd.dll and full of SDK names, so without that a folder
    that has already been set up would report that the game uses the SDK - the exact mistake this
    tool exists to prevent.
    """
    found = {"sdk": set(), "old": set(), "device": set(), "middleware": set(), "scripts": set()}
    ours = False
    for wide in (False, True):
        text = strings_of(path, wide=wide).lower()
        if not text:
            continue
        if "lcd-probe.log" in text:
            ours = True
        for name in SDK_NAMES:
            if name.lower() in text:
                found["sdk"].add(name)
        for name in OLD_NAMES:
            if name.lower() in text:
                found["old"].add(name)
        for name in DEVICE_NAMES:
            if name.lower() in text:
                found["device"].add(name)
        for name in MIDDLEWARE_NAMES:
            if name.lower() in text:
                found["middleware"].add(name)
        for name in SCRIPT_NAMES:
            if name.lower() in text:
                found["scripts"].add(name)
    if ours:
        return {"sdk": set(), "old": set(), "device": set(), "middleware": set(),
                "scripts": set(), "ours": True}
    return found


def look_at(folder):
    """Every executable and library in a game folder, and what each one says."""
    verdicts = []
    for root, directories, files in os.walk(folder):
        directories[:] = [d for d in directories if not d.startswith(".")]
        for entry in sorted(files):
            path = os.path.join(root, entry)
            try:
                size = os.path.getsize(path)
            except OSError:
                continue
            if size > BIG:
                continue
            wanted = entry.lower().endswith(INTERESTING)
            if not wanted:
                try:
                    with open(path, "rb") as handle:
                        wanted = handle.read(4) == b"\x7fELF"
                except OSError:
                    continue
            if not wanted:
                continue
            found = what_it_uses(path)
            if found.get("ours"):
                verdicts.append((path, pe_architecture(path), found))
            elif (found["sdk"] or found["old"] or found["device"] or found["middleware"]
                    or found["scripts"]):
                verdicts.append((path, pe_architecture(path), found))
    return verdicts


def report(label, folder):
    """Prints what a game needs, and what to do about it."""
    print("\n%s" % label)
    print("  %s" % folder)
    verdicts = look_at(folder)
    if not verdicts:
        # Nothing found is not proof: a packed executable can hide its own imports.
        print("   nothing found. This game either has no Logitech LCD support, or hides the names")
        print("   from a plain string search (a packed or protected executable does).")
        return "none"

    outcome = "none"
    the_game_says_something = False
    for path, architecture, found in verdicts:
        print("   %s%s" % (os.path.relpath(path, folder), "  (%s)" % architecture
                           if architecture else ""))
        if found.get("ours"):
            print("      this is the driver's own shim, already in place - not the game's doing")
            continue
        if found.get("scripts") and not (found["sdk"] or found["old"] or found["device"]):
            print("      the game's own scripts have an LCD helper: %s"
                  % ", ".join(sorted(found["scripts"])[:3]))
            print("      -> the feature exists in the game. On Windows its native half is what a")
            print("         Logitech SDK call would drive; a Linux port can have the scripts and")
            print("         not the hardware half.")
        if found.get("middleware") and not (found["sdk"] or found["old"] or found["device"]):
            print("      an LCD middleware is compiled in: %s"
                  % ", ".join(sorted(found["middleware"])[:3]))
            print("      -> built to draw on an LCD, but nothing here names a Logitech library.")
            print("         Games like this are usually driven by Logitech's own software reading")
            print("         the game, which a DLL shim cannot stand in for.")
        the_game_says_something = True
        if found["sdk"]:
            outcome = "sdk"
            print("      Logitech LCD SDK: %s" % ", ".join(sorted(found["sdk"])[:4]))
            print("      -> copy LogitechLcd.dll (%s) into %s as LogitechLcd.dll"
                  % (architecture or "the matching build", os.path.dirname(path)))
        if found["old"]:
            print("      the older LCD Manager API: %s" % ", ".join(sorted(found["old"])[:4]))
            print("      -> a different set of calls; the shim does not speak it yet")
            outcome = "old"
        if found["device"]:
            print("      the Logitech driver's device: %s" % ", ".join(sorted(found["device"])))
            print("      -> opened directly, which cannot be stood in for outside Windows")
            outcome = "device"

    if not the_game_says_something:
        # The only thing found was the driver's own shim, which says nothing about the game. The
        # question being asked is about the game, so answer that one.
        print("   nothing found in the game itself. It either has no Logitech LCD support, or hides")
        print("   the names from a plain string search (a packed or protected executable does).")
        return "none"
    return outcome


def steam_games():
    """Every installed Steam game, from Steam's own manifests.

    Steam writes one appmanifest per installed game, naming the folder it went into. Listing the
    "common" directory instead would count Proton and the Steam Linux Runtime as games, which is
    how a first attempt at this reported four copies of the same thing.
    """
    found = []
    seen = set()
    for account in ("~/.steam/debian-installation", "~/.steam/steam", "~/.local/share/Steam"):
        root = os.path.expanduser(account)
        libraries = [root]
        listing = os.path.join(root, "steamapps", "libraryfolders.vdf")
        if os.path.exists(listing):
            for line in open(listing, encoding="utf-8", errors="ignore"):
                if '"path"' in line:
                    libraries.append(line.split('"')[3])
        for library in libraries:
            steamapps = os.path.join(library, "steamapps")
            if not os.path.isdir(steamapps):
                continue
            for entry in sorted(os.listdir(steamapps)):
                if not entry.startswith("appmanifest_") or not entry.endswith(".acf"):
                    continue
                name, install = None, None
                for line in open(os.path.join(steamapps, entry), encoding="utf-8", errors="ignore"):
                    parts = line.split('"')
                    if len(parts) >= 4 and parts[1] == "name":
                        name = parts[3]
                    if len(parts) >= 4 and parts[1] == "installdir":
                        install = parts[3]
                if not install:
                    continue
                folder = os.path.join(steamapps, "common", install)
                # Two accounts of the same library (a symlinked ~/.steam/steam, say) must not be
                # read twice, and Proton is not a game.
                key = os.path.realpath(folder)
                if key in seen or not os.path.isdir(folder):
                    continue
                if any(tool in (name or "") for tool in NOT_A_GAME):
                    continue
                seen.add(key)
                found.append((name or install, folder))
    return found


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0

    if argv[0] == "--steam":
        games = steam_games()
        if not games:
            print("no Steam games found where Steam keeps them")
            return 2
        print("checking %d installed Steam games" % len(games))
        interesting = []
        for name, path in games:
            outcome = report(name, path)
            if outcome != "none":
                interesting.append((name, outcome))
        print("\n%d of %d mention a Logitech LCD at all:" % (len(interesting), len(games)))
        for name, outcome in interesting:
            print("   %-40s %s" % (name, outcome))
        return 0

    outcome = "none"
    for folder in argv:
        if not os.path.isdir(folder):
            print("not a folder: %s" % folder)
            continue
        result = report(os.path.basename(folder.rstrip("/")), folder)
        if result != "none":
            outcome = result
    return 0 if outcome == "none" or outcome == "sdk" else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
