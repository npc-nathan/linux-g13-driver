#!/usr/bin/env python3
"""Point a game's Wine prefix at this driver's LogitechLcd.dll, the way Logitech's SDK is found.

The Logitech LCD SDK is not found by name. Its loader asks Windows for a class id --

    {d0e790a5-01a7-49ae-ae0b-e986bdd0c21b}

-- and reads the `ServerBinary` value under it (a 32-bit program under the Wow6432Node view).
Logitech Gaming Software writes that key when it installs; a Wine prefix has no Logitech software
in it, so the key is absent, and a game that uses the SDK finds nothing at all. That failure is
silent, which is why a game can support the LCD, contain no trace of Logitech's name in any string,
and still never appear to try.

So this copies the 32-bit DLL to `C:\g13\LogitechLcd.dll` inside the prefix (a fixed place
that does not depend on the game's folder or a drive letter) and teaches the prefix where it is.

Three rules, each learned the hard way:

1. **Registry writes go through `wine reg add`, never by editing system.reg.** Wine keeps the
   registry in memory and writes the whole file back when the last process exits, so a key added
   to that file behind Wine's back is silently discarded -- which is what a first version of this
   did, and why a game tested with it showed nothing.
2. **Use the game's own Wine.** A Steam game runs under the Proton Steam selected for it; a Heroic
   game runs under the Proton Heroic downloaded (often Proton-CachyOS), which is *not* Steam's.
   Writing a prefix with a different Wine than the one that runs it is how a prefix gets altered
   behind the game's back. This resolves the right one per prefix, or takes `--wine`.
3. **Say which Wine was used, every time.** No silent guessing.

    g13-lcd-sdk-register <prefix>              one prefix
    g13-lcd-sdk-register --steam-appid 47810   one Steam game (compatdata/<appid>)
    g13-lcd-sdk-register --all                 every Steam and Heroic prefix found
    g13-lcd-sdk-register --status              which prefixes are set up (no Wine, instant)
    g13-lcd-sdk-register --verify <prefix>     read the key back the way a game would
    g13-lcd-sdk-register --remove <prefix>     take it back out
    g13-lcd-sdk-register --wine /path/to/wine <prefix>   force a particular Wine
"""
import glob
import os
import re
import shutil
import subprocess
import sys

CLSID = "{d0e790a5-01a7-49ae-ae0b-e986bdd0c21b}"
INSIDE = "C:\\g13\\LogitechLcd.dll"          # where the DLL goes inside the prefix
VIEWS = [
    "HKLM\\Software\\Classes\\CLSID\\%s\\ServerBinary" % CLSID,
    "HKLM\\Software\\Classes\\Wow6432Node\\CLSID\\%s\\ServerBinary" % CLSID,
    "HKLM\\Software\\Wow6432Node\\Classes\\CLSID\\%s\\ServerBinary" % CLSID,
]
LIVE = VIEWS[1]                               # the one a 32-bit program actually reads
STEAM_HOMES = ("~/.steam/steam", "~/.steam/debian-installation", "~/.local/share/Steam")
HEROIC_TOOLS = "~/.var/app/com.heroicgameslauncher.hgl/config/heroic/tools/proton"
HEROIC_GAMES = "~/.var/app/com.heroicgameslauncher.hgl/config/heroic/GamesConfig"
FORCED_WINE = None


def wine_bits(binary):
    """The two things a Wine binary needs from its own tree: LD_LIBRARY_PATH and the binary."""
    top = os.path.dirname(os.path.dirname(binary))
    return [binary], {"LD_LIBRARY_PATH": "%s/lib64:%s/lib" % (top, top)}


def installed_protons():
    found = []
    for home in STEAM_HOMES:
        for directory in sorted(glob.glob(os.path.expanduser(home) + "/steamapps/common/Proton*")):
            binary = os.path.join(directory, "files", "bin", "wine")
            if os.path.exists(binary):
                found.append((os.path.basename(directory), binary))
    return found


def heroic_protons():
    found = []
    for directory in sorted(glob.glob(os.path.expanduser(HEROIC_TOOLS) + "/*")):
        binary = os.path.join(directory, "files", "bin", "wine")
        if os.path.exists(binary):
            found.append((os.path.basename(directory), binary))
    return found


def steam_appid_of(prefix):
    match = re.search(r"/compatdata/(\d+)/", prefix + "/")
    return match.group(1) if match else None


def steam_chosen_proton(appid):
    """Steam records the tool it will use for an app; the default is the newest installed."""
    for home in STEAM_HOMES:
        for name in ("config/config.vdf", "config/localconfig.vdf", "userdata/*/config/localconfig.vdf"):
            for path in glob.glob(os.path.expanduser(home) + "/" + name):
                try:
                    text = open(path, encoding="utf-8", errors="ignore").read()
                except OSError:
                    continue
                match = re.search(r'"%s"\s*\{(.{0,300}?)\}' % appid, text, re.S)
                if match and '"name"' in match.group(1):
                    wanted = re.search(r'"name"\s*"([^"]+)"', match.group(1)).group(1)
                    for installed, binary in installed_protons():
                        if wanted.lower().replace("proton_", "").replace(".", "") in \
                                installed.lower().replace(" ", "").replace(".", ""):
                            return installed, binary, "Steam's choice for %s (%s)" % (appid, wanted)
                    return None, None, "Steam chose '%s' for %s, which is not installed here" % (wanted, appid)
    protons = installed_protons()
    if len(protons) == 1:
        return protons[0][0], protons[0][1], "the only Proton installed"
    if protons:
        return protons[-1][0], protons[-1][1], "newest of %d Protons installed" % len(protons)
    return None, None, "no Steam Proton installed"


def wine_for(prefix):
    """(binary, env, a sentence naming it) for the Wine that actually runs this prefix."""
    if FORCED_WINE:
        binaries, env = wine_bits(FORCED_WINE)
        return binaries, env, "--wine %s" % FORCED_WINE

    heroic = os.path.expanduser("~/Games/Heroic/Prefixes")
    if os.path.abspath(prefix).startswith(heroic + os.sep):
        protons = heroic_protons()
        if len(protons) == 1:
            binaries, env = wine_bits(protons[0][1])
            return binaries, env, "Heroic's own Proton (%s)" % protons[0][0]
        if protons:
            binaries, env = wine_bits(protons[-1][1])
            return binaries, env, "Heroic's newest Proton (%s of %d)" % (protons[-1][0], len(protons))
        return None, None, "Heroic's Proton folder is empty"

    appid = steam_appid_of(prefix)
    if appid:
        name, binary, reason = steam_chosen_proton(appid)
        if not binary:
            return None, None, reason
        binaries, env = wine_bits(binary)
        return binaries, env, "Steam's Proton (%s, %s)" % (name, reason)

    found = shutil.which("wine")
    if found:
        return [found], {}, "system wine"
    found = shutil.which("wine64")
    if found:
        return [found], {}, "system wine64"
    return None, None, "no Wine found for this prefix"


def wine_run(command, prefix):
    binaries, env_extra, description = wine_for(prefix)
    if not binaries:
        return 127, description
    environment = dict(os.environ)
    environment.update(env_extra)
    environment["WINEPREFIX"] = prefix
    environment.setdefault("WINEDEBUG", "-all")
    try:
        finished = subprocess.run(binaries + command, capture_output=True, text=True,
                                  env=environment, timeout=240)
    except (OSError, subprocess.TimeoutExpired) as problem:
        return 126, str(problem)
    return finished.returncode, (finished.stdout or "") + (finished.stderr or "")


def shim_path():
    here = os.path.dirname(os.path.abspath(__file__))
    for candidate in (os.path.join(here, "LogitechLcd.dll"),
                      os.path.join(here, "..", "lcdsdk", "LogitechLcd.dll"),
                      os.path.join(here, "g13-driver", "src", "lcdsdk", "LogitechLcd.dll")):
        if os.path.exists(candidate):
            return os.path.abspath(candidate)
    return None


def steam_prefixes():
    found = []
    for home in STEAM_HOMES:
        for entry in sorted(glob.glob(os.path.expanduser(home) + "/steamapps/compatdata/*/pfx")):
            if os.path.isdir(entry):
                found.append((os.path.basename(os.path.dirname(entry)), entry))
    return found


def heroic_prefixes():
    found = []
    for entry in sorted(glob.glob(os.path.expanduser("~/Games/Heroic/Prefixes") + "/*")):
        if os.path.isdir(entry):
            found.append((os.path.basename(entry), entry))
    return found


def steam_prefix_for(appid):
    for found_appid, path in steam_prefixes():
        if found_appid == str(appid):
            return path
    return None


def is_registered(prefix):
    """Cheap: is the DLL in the prefix? Reading the key itself means a Wine launch (seconds)."""
    return os.path.exists(os.path.join(prefix, "drive_c", "g13", "LogitechLcd.dll"))


def key_is_readable(prefix):
    code, output = wine_run(["reg", "query", LIVE], prefix)
    return code == 0 and "LogitechLcd.dll" in output


def register(prefix):
    if not os.path.isdir(os.path.join(prefix, "drive_c")):
        return "not a Wine prefix (no drive_c inside)"
    source = shim_path()
    if not source:
        return "cannot find LogitechLcd.dll to install (build it with make windows)"
    binaries, env, description = wine_for(prefix)
    if not binaries:
        return description
    inside = os.path.join(prefix, "drive_c", "g13")
    os.makedirs(inside, exist_ok=True)
    shutil.copy2(source, os.path.join(inside, "LogitechLcd.dll"))

    for view in VIEWS:
        code, output = wine_run(["reg", "add", view, "/ve", "/d", INSIDE, "/f"], prefix)
        if code != 0:
            return "wine (%s) could not write %s" % (description, view)
    if not key_is_readable(prefix):
        return "wrote the keys with %s but could not read them back" % description
    return None


def remove(prefix):
    for view in VIEWS:
        wine_run(["reg", "delete", view, "/f"], prefix)
    shutil.rmtree(os.path.join(prefix, "drive_c", "g13"), ignore_errors=True)
    return None


def main(argv):
    global FORCED_WINE
    args = list(argv)
    if "--help" in args or not args:
        print(__doc__.strip())
        return 0
    if "--wine" in args:
        at = args.index("--wine")
        FORCED_WINE = args[at + 1] if len(args) > at + 1 else None
        del args[at:at + 2]
        if not FORCED_WINE or not os.path.exists(FORCED_WINE):
            print("--wine needs the path to a wine binary")
            return 1
    if "--verify" in args:
        at = args.index("--verify")
        prefix = args[at + 1] if len(args) > at + 1 else ""
        _, _, description = wine_for(prefix)
        print("%-60s %s" % (prefix, "reads back" if key_is_readable(prefix) else "KEY MISSING"))
        print("   using %s" % description)
        return 0 if key_is_readable(prefix) else 1
    if "--remove" in args:
        args.remove("--remove")
        for prefix in args:
            remove(prefix)
            print("%-60s key removed" % prefix)
        return 0
    if "--status" in args:
        pairs = steam_prefixes() + heroic_prefixes()
        if not pairs:
            print("no Steam or Heroic prefixes found")
            return 1
        for name, path in pairs:
            print("%-34s %-8s %s" % (name, "set up" if is_registered(path) else "-", path))
        return 0

    if "--all" in args:
        targets = steam_prefixes() + heroic_prefixes()
        if not targets:
            print("no Steam or Heroic prefixes found")
            return 1
    elif "--steam-appid" in args:
        at = args.index("--steam-appid")
        appid = args[at + 1] if len(args) > at + 1 else ""
        prefix = steam_prefix_for(appid)
        if not prefix:
            print("Steam %s has to have been run once before its prefix exists" % appid)
            return 1
        targets = [(appid, prefix)]
    else:
        targets = [("", path) for path in args]

    failed = 0
    for name, path in targets:
        _, _, description = wine_for(path)
        problem = register(path)
        if problem:
            failed = 1
            print("%-52s %s" % (path, problem))
        else:
            print("%-52s registered via %s" % (path, description))
    if not failed:
        print("\nA game that uses the Logitech LCD SDK now loads this driver's LogitechLcd.dll.")
        print("Start it and watch: `g13-visuals --status` says `an SDK client` while the game")
        print("owns the screen. Nothing belongs in launch options, and it stays set up.")
    return failed


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
