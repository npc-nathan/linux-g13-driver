#!/usr/bin/env python3
"""Write to the Logitech G13's LCD screen.

    g13-lcd "CPU 42%" "MEM 61%"     # a screen of text lines (clears first)
    g13-lcd --at 4 8 "top left"     # one line at a position, without clearing
    g13-lcd --clear
    g13-lcd --image shot.pbm        # a bitmap, scaled to fit and centred
    g13-lcd --hex 0001ff...         # a raw 960 byte frame (1920 hex digits)

Everything else lives in g13lcd.py, which is also importable by anything that wants to
draw on the screen.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import g13lcd  # noqa: E402

def main(argv):
    path = None
    if "--pipe" in argv:
        index = argv.index("--pipe")
        path = argv[index + 1]
        del argv[index:index + 2]

    if not argv:
        print(__doc__.strip())
        return 0

    command = argv[0]
    if command == "--clear":
        g13lcd.clear(path=path)
    elif command == "--at":
        if len(argv) < 4:
            raise SystemExit("--at needs X Y TEXT")
        g13lcd.at(argv[1], argv[2], " ".join(argv[3:]), path=path)
    elif command == "--image":
        if len(argv) < 2:
            raise SystemExit("--image needs a .pbm file")
        g13lcd.frame(g13lcd.pixels_to_frame(g13lcd.fit(g13lcd.read_pbm(argv[1]))), path=path)
    elif command == "--hex":
        if len(argv) < 2:
            raise SystemExit("--hex needs %d hex digits" % (g13lcd.FRAME_BYTES * 2))
        g13lcd.send(["#bitmap " + argv[1]], path=path)
    elif command in ("-h", "--help"):
        print(__doc__.strip())
    else:
        g13lcd.text(*argv, path=path)

    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except OSError as error:
        print("Could not write to the LCD: %s" % error, file=sys.stderr)
        print("Is the driver running?  systemctl --user status g13.service", file=sys.stderr)
        sys.exit(1)
