#!/usr/bin/env python3
"""Relays the Windows LogitechLcd.dll to the driver.

A Windows program - a game with native Logitech LCD support, running under Wine or Proton -
cannot use the driver's Unix socket or FIFO. So the Windows build of our LogitechLcd.dll
connects here over TCP on 127.0.0.1 and speaks exactly the driver's own protocol:

    frames in:  #bitmap <1920 hex chars> / #text <x> <y> <text>   -> the driver's LCD pipe
    events out: key <code> <0|1>                                  <- the driver's event socket

It is a relay, not a translator: the lines are already in the driver's form. While at least
one client is connected it keeps $XDG_RUNTIME_DIR/g13-sdk-client fresh, which is how the
visuals daemon knows an SDK client owns the screen and the four buttons beside it.

    g13-lcd-bridge [--port 51513] [--verbose]

Nothing here needs the device.
"""
import argparse
import errno
import os
import socket
import sys
import threading
import time

DEFAULT_PORT = 51513
CLIENT_FILE = "g13-sdk-client"


def runtime_dir():
    return os.environ.get("XDG_RUNTIME_DIR") or "/run/user/%d" % os.getuid()


class Bridge:
    def __init__(self, port, verbose=False):
        self.port = port
        self.verbose = verbose
        self.clients = []
        self.lock = threading.Lock()
        self.lcd_fd = None
        self.driver_present = None
        self.button_state = {}      # code -> 0|1, so a client that arrives late knows
        self.running = True

    def log(self, message):
        if self.verbose:
            print("g13-lcd-bridge: %s" % message, flush=True)

    def client_file(self):
        return os.path.join(runtime_dir(), CLIENT_FILE)

    def touch_client_file(self):
        """Straight away, not on the next poll: the daemon decides who owns the four buttons
        from this file, and a client that connects and leaves quickly must still be seen."""
        try:
            with open(self.client_file(), "w") as handle:
                handle.write("\n")
        except OSError:
            pass

    def clear_client_file(self):
        try:
            os.remove(self.client_file())
        except OSError:
            pass

    def announce_driver(self):
        """Tell the clients whether the driver is really there.

        A bridge that is listening with no driver behind it must not look like a working
        screen: the SDK's IsConnected is a question about a panel, not about us.
        """
        present = self.open_screen() is not None
        if present == self.driver_present:
            return
        self.driver_present = present
        self.broadcast(b"state driver %d\n" % (1 if present else 0))
        self.log("driver present: %s" % present)

    # --- the driver side ---------------------------------------------------

    def open_screen(self):
        """The driver's LCD pipe, opened for writing without blocking. A driver that is not
        running gives ENXIO, which just means the frame goes nowhere."""
        if self.lcd_fd is not None:
            return self.lcd_fd
        path = os.path.join(runtime_dir(), "g13-lcd")
        try:
            self.lcd_fd = os.open(path, os.O_WRONLY | os.O_NONBLOCK)
            self.log("writing frames to %s" % path)
        except OSError as error:
            if error.errno not in (errno.ENXIO, errno.ENOENT, errno.EACCES):
                self.log("cannot open %s: %s" % (path, error))
            self.lcd_fd = None
        return self.lcd_fd

    def write_frame(self, data):
        fd = self.open_screen()
        if fd is None:
            return
        try:
            os.write(fd, data)
        except OSError as error:
            if error.errno in (errno.EPIPE, errno.EAGAIN, errno.EBADF):
                # The driver went away or is not reading: drop this frame and re-open next
                # time rather than stalling the game that sent it.
                try:
                    os.close(fd)
                except OSError:
                    pass
                self.lcd_fd = None
            else:
                self.log("write failed: %s" % error)

    def broadcast(self, line):
        with self.lock:
            clients = list(self.clients)
        for client in clients:
            try:
                client.sendall(line)
            except OSError:
                pass

    def watch_driver(self):
        """Pass the driver's button events to the connected clients."""
        while self.running:
            connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            path = os.path.join(runtime_dir(), "g13.sock")
            try:
                connection.connect(path)
                self.log("listening to %s for button events" % path)
            except OSError:
                connection.close()
                time.sleep(2)     # no driver yet: try again, nothing depends on it
                continue

            connection.settimeout(1)
            try:
                while self.running:
                    try:
                        data = connection.recv(4096)
                    except socket.timeout:
                        continue
                    except OSError:
                        break
                    if not data:
                        break
                    # Remember the button states: a client connecting later asks which
                    # buttons are down right now, and the driver only reports changes.
                    for piece in data.splitlines():
                        parts = piece.split()
                        if len(parts) == 3 and parts[0] == b"key" and parts[1].isdigit():
                            self.button_state[int(parts[1])] = int(parts[2])
                    self.broadcast(data)
            finally:
                connection.close()
            time.sleep(1)

    # --- the client side ---------------------------------------------------

    def keep_client_file(self):
        """Fresh while a client is connected; the daemon treats a stale file as gone, so a
        killed client cannot leave the pad deaf to its own buttons."""
        path = os.path.join(runtime_dir(), CLIENT_FILE)
        while self.running:
            with self.lock:
                connected = bool(self.clients)
            try:
                if connected:
                    with open(path, "w") as handle:
                        handle.write("\n")
                elif os.path.exists(path):
                    os.remove(path)
            except OSError:
                pass
            self.announce_driver()
            time.sleep(0.5)

    def serve_client(self, connection, address):
        self.log("client connected from %s" % (address,))
        self.touch_client_file()
        # A client that arrives after the driver went away still needs the true answer, and
        # one that arrives while a button is held needs to know it is held.
        self.announce_driver()
        for code, value in sorted(self.button_state.items()):
            try:
                connection.sendall(b"key %d %d\n" % (code, value))
            except OSError:
                break
        if self.driver_present is not None:
            try:
                connection.sendall(b"state driver %d\n" % (1 if self.driver_present else 0))
            except OSError:
                pass
        try:
            while self.running:
                data = connection.recv(65536)
                if not data:
                    break
                self.write_frame(data)
        except OSError:
            pass
        finally:
            with self.lock:
                if connection in self.clients:
                    self.clients.remove(connection)
            try:
                connection.close()
            except OSError:
                pass
            with self.lock:
                left = list(self.clients)
            if not left:
                self.clear_client_file()
            self.log("client disconnected")

    def run(self):
        server = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        server.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        server.bind(("127.0.0.1", self.port))
        server.listen(4)
        print("g13-lcd-bridge: listening on 127.0.0.1:%d" % self.port, flush=True)

        threading.Thread(target=self.watch_driver, daemon=True).start()
        threading.Thread(target=self.keep_client_file, daemon=True).start()

        try:
            while self.running:
                connection, address = server.accept()
                with self.lock:
                    self.clients.append(connection)
                threading.Thread(target=self.serve_client, args=(connection, address),
                                 daemon=True).start()
        except KeyboardInterrupt:
            pass
        finally:
            self.running = False
            server.close()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--port", type=int,
                        default=int(os.environ.get("G13_LCD_TCP_PORT", DEFAULT_PORT)))
    parser.add_argument("--verbose", action="store_true")
    arguments = parser.parse_args()
    Bridge(arguments.port, arguments.verbose).run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
