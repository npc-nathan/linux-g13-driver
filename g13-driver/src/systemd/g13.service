[Unit]
Description=Logitech G13 User Space Driver
After=graphical-session.target
# The driver creates a tray icon, so it needs an X11/Wayland display. Without
# this it is started at login before the graphical session exists, gtk_init()
# fails with "cannot open display" and systemd restarts it until the session
# is up.
Wants=graphical-session.target

[Service]
Type=simple
# Standard-Pfad für Paket-Installationen.
# Wird bei "make install-user" via sed automatisch angepasst.
ExecStart=/usr/bin/linux-g13-driver
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target