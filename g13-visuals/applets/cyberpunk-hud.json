{
  "name": "cyberpunk-hud",
  "title": "COMBAT HUD",
  "border": true,
  "interval": 0.2,
  "sources": {
    "ammo": "json:~/.local/share/cyberpunk-gta/hud.json#ammo",
    "mag": "json:~/.local/share/cyberpunk-gta/hud.json#mag",
    "health": "json:~/.local/share/cyberpunk-gta/hud.json#health",
    "objective": "json:~/.local/share/cyberpunk-gta/hud.json#objective",
    "turn": "json:~/.local/share/cyberpunk-gta/hud.json#turn",
    "distance": "json:~/.local/share/cyberpunk-gta/hud.json#distance"
  },
  "widgets": [
    {"type": "segments", "x": 3, "y": 12, "w": 60, "h": 5, "count": 12, "source": "health", "max": 100},
    {"type": "text", "x": 70, "y": 12, "format": "AMMO {ammo:>3}"},
    {"type": "text", "y": 12, "align": "right", "format": "MAG {mag:>2}"},

    {"type": "text", "x": 3, "y": 20, "format": "{objective}", "scroll": true, "scroll_width": 25, "scroll_speed": 3},

    {"type": "line", "x": 1, "y": 27, "w": 158},
    {"type": "brackets", "x": 1, "y": 28, "w": 18, "h": 13, "len": 5, "thick": 2},
    {"type": "turn", "x": 4, "y": 29, "size": 11, "source": "turn"},
    {"type": "text", "x": 23, "y": 32, "format": "NEXT {distance}m"}
  ]
}
