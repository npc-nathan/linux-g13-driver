{
  "name": "demo-stats",
  "title": "STATS",
  "interval": 1,
  "widgets": [
    {"type": "text", "x": 3, "y": 12, "format": "CPU"},
    {"type": "bar", "x": 28, "y": 12, "w": 100, "h": 9, "source": "cpu", "max": 100},
    {"type": "text", "x": 157, "y": 12, "align": "right", "format": "{cpu:.0f}%"},

    {"type": "text", "x": 3, "y": 22, "format": "MEM"},
    {"type": "bar", "x": 28, "y": 22, "w": 100, "h": 9, "source": "memory", "max": 100},
    {"type": "text", "x": 157, "y": 22, "align": "right", "format": "{memory:.0f}%"},

    {"type": "line", "x": 1, "y": 33, "w": 158},
    {"type": "text", "x": 3, "y": 35, "format": "{day} {date} up {uptime}"}
  ]
}
