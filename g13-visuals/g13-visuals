def number_or(value, default):
    """A number from a hand-written JSON file, or the default if it is not one.

    Applets are files people edit by hand, so a wrong type is an ordinary mistake rather than a
    reason to fail: the daemon keeps drawing with the default, and `g13-applet check` is what
    tells the author about it.
    """
    if value is None or isinstance(value, bool):
        return default
    if isinstance(value, (int, float)):
        return value
    try:
        return float(value)
    except (TypeError, ValueError):
        return default


def text_problems(lines, width=None, height=None):
    """Everything wrong with the text in one drawn screen, as the driver would see it.

    The panel has one colour of ink and text is drawn over the pixels, so text that lands on a
    filled pixel is invisible; text below the visible rows, or running past the right edge, never
    shows either. `lines` is the driver's protocol - the `#bitmap` frame and the `#text` lines
    after it - so what is checked is what would actually be sent to the pad.

    Shared on purpose: the tool's preview, `g13-applet check` and the test suite use this one
    rule rather than each having an opinion. It used to live in the test suite alone.
    """
    width = g13lcd.VISIBLE_WIDTH if width is None else width
    height = g13lcd.VISIBLE_HEIGHT if height is None else height
    if not lines:
        return ["nothing was drawn"]
    if not lines[0].startswith("#bitmap "):
        return ["the first line is not a frame: %r" % str(lines[0])[:40]]
    try:
        frame = bytes.fromhex(lines[0].split(" ", 1)[1])
    except ValueError:
        return ["the frame is not hex"]

    problems = []
    for line in lines[1:]:
        parts = line.split(" ", 3)
        if parts[0] != "#text" or len(parts) < 3:
            continue
        x, y = int(parts[1]), int(parts[2])
        message = parts[3] if len(parts) > 3 else ""
        if y < 0 or y + g13lcd.TEXT_HEIGHT > height:
            problems.append("text off the visible screen: %r at y=%d" % (message, y))
        if x < 0 or x + len(message) * g13lcd.CHAR_WIDTH > width:
            problems.append("text off the visible screen: %r runs to x=%d"
                            % (message, x + len(message) * g13lcd.CHAR_WIDTH))
        for column in range(max(0, x), min(width, x + len(message) * g13lcd.CHAR_WIDTH)):
            for row in range(max(0, y), min(height, y + g13lcd.TEXT_HEIGHT)):
                index = column + (row // 8) * g13lcd.WIDTH
                if index < len(frame) and frame[index] & (1 << (row % 8)):
                    problems.append("%r overlaps filled pixels at (%d,%d)" % (message, column, row))
    return problems


def layout_problems(visual, context=None):
    """The same check for one visual: draw it, and look at what came out."""
    screen = Screen()
    visual.render(screen, context or {})
    return text_problems(screen.lines())


def centred(message, width=None):
    """Left padding that centres a string on the screen."""
    width = width or g13lcd.VISIBLE_WIDTH
    return max(0, (width - len(message) * 6) // 2)


def scrolling(message, widget, now=None):
    """A sliding window onto a long line, for text that does not fit.

    An objective is not twenty-five characters, and cutting it off loses the half that
    matters. The line wraps round with a gap between its end and its start, so a title that
    fits is left alone and one that does not is readable in a single pass.
    """
    window = int(number_or(widget.get("scroll_width"), 25)) or 25
    speed = float(number_or(widget.get("scroll_speed"), 3))
    if len(message) <= window:
        return message
    padded = message + "   "
    offset = int((time.time() if now is None else now) * speed) % len(padded)
    return (padded + padded)[offset:offset + window]


class ClockVisual:
    name = "clock"
    title = "CLOCK"
    interval = 1.0

    def render(self, screen, context):
        now = datetime.now()
        screen.frame_and_title(self.title)
        screen.text(centred(now.strftime("%H:%M:%S")), 17, now.strftime("%H:%M:%S"))
        screen.text(centred(now.strftime("%a %d %b %Y")), 29, now.strftime("%a %d %b %Y"))


class SystemVisual:
    name = "system"
    title = "SYSTEM"
    interval = 2.0

    def __init__(self):
        self.previous = None

    def cpu_percent(self):
        """Busy share of the cpu since the last look."""
        with open("/proc/stat") as handle:
            fields = [int(value) for value in handle.readline().split()[1:]]
        idle = fields[3] + fields[4]
        total = sum(fields)

        if self.previous is None:
            self.previous = (idle, total)
            return 0

        idle_delta = idle - self.previous[0]
        total_delta = total - self.previous[1]
        self.previous = (idle, total)
        if total_delta <= 0:
            return 0
        return int(100 * (total_delta - idle_delta) / total_delta)

    def memory_percent(self):
        values = {}
        with open("/proc/meminfo") as handle:
            for line in handle:
                key, _, rest = line.partition(":")
                values[key] = int(rest.split()[0])
        total = values.get("MemTotal", 1)
        available = values.get("MemAvailable", 0)
        return int(100 * (total - available) / total)

    def render(self, screen, context):
        usage = self.cpu_percent()
        memory = self.memory_percent()
        with open("/proc/loadavg") as handle:
            load = float(handle.read().split()[0])
        with open("/proc/uptime") as handle:
            uptime = float(handle.read().split()[0])

        screen.frame_and_title(self.title)
        for row, (label, percent) in enumerate((("CPU", usage), ("MEM", memory))):
            y = 12 + row * 10
            screen.text(3, y, label)
            screen.bar(28, y, 88, 8, percent)
            screen.text(122, y, "%3d%%" % percent)

        hours = int(uptime // 3600)
        screen.text(3, 33, "LOAD %.2f   UP %dh%02dm" % (load, hours, int(uptime % 3600) // 60))


class MediaVisual:
    name = "media"
    title = "MEDIA"
    interval = 1.0

    def metadata(self):
        """What the running media player reports, or None."""
        try:
            result = subprocess.run(
                ["playerctl", "metadata", "--format",
                 "{{status}}|{{artist}}|{{title}}|{{position}}|{{mpris:length}}"],
                capture_output=True, text=True, timeout=0.5)
        except (OSError, subprocess.SubprocessError):
            return None

        if result.returncode != 0 or not result.stdout.strip():
            return None
        parts = (result.stdout.strip().split("|") + [""] * 5)[:5]
        return parts

    def render(self, screen, context):
        screen.frame_and_title(self.title)
        data = self.metadata()

        if data is None:
            screen.text(centred("no player"), 18, "no player")
            return

        status, artist, title, position, length = data
        playing = "playing" if status == "Playing" else status.lower() or "stopped"
        screen.text(3, 12, (title or "unknown")[:24])
        screen.text(3, 21, (artist or "")[:24])

        try:
            done = int(position) // 1_000_000
            total = int(length) // 1_000_000
        except (TypeError, ValueError):
            done, total = 0, 0

        percent = int(100 * done / total) if total else 0
        screen.bar(3, 32, 110, 8, percent)
        screen.text(118, 32, ("%d:%02d" % (done // 60, done % 60)) if total else playing)


class PadVisual:
    name = "pad"
    title = "PAD"
    interval = 1.0

    def render(self, screen, context):
        screen.frame_and_title(self.title)
        profile = context.get("profile", 0)
        screen.text(3, 12, "PROFILE M%d" % (profile + 1))

        recording = "RECORDING" if context.get("recording") else "idle"
        screen.text(3, 21, "MR: %s" % recording)

        recent = context.get("recent", [])
        screen.text(3, 31, " ".join(recent[-6:]) or "-")


class CustomVisual:
    name = "custom"
    title = "CUSTOM"
    interval = 1.0

    def render(self, screen, context):
        screen.frame_and_title(self.title)
        path = config_dir() / "screen.txt"
        try:
            lines = path.read_text().splitlines()
        except OSError:
            lines = []

        if not lines:
            screen.text(3, 18, "put text in")
            screen.text(3, 28, "screen.txt")
            return

        for index, line in enumerate(lines[:4]):
            screen.text(3, 12 + index * 8, line)

    def lines(self):
        # The visual's own name for the menu.
        return self.name


