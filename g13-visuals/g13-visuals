PUBLISHED_SOURCES = [
    "cpu", "memory", "load", "uptime", "uptime_seconds", "time", "time_seconds", "date",
    "day", "media_status", "media_artist", "media_title", "media_position",
    "media_duration", "media_percent", "profile", "recording", "last_key", "recent_keys",
    "screen_width", "screen_height",
]

# Who owns the screen and the four buttons beside it. Logitech's own software rotated between
# applets; here it is one or the other, chosen by whoever is using the pad.
BUTTON_MODE_FILE = "button-mode"
BUTTON_MODES = ("auto", "visuals", "sdk")

# Our Logitech LCD SDK implementation touches this while it is drawing, and the Windows
# bridge keeps it fresh while a client is connected.
SDK_CLIENT_FILE = "g13-sdk-client"
SDK_CLIENT_FRESH_SECONDS = 3.0


def runtime_path(name):
    """Where the driver, the daemon and the tools meet: a FIFO, a socket or a state file.

    `XDG_RUNTIME_DIR` comes first. Without it - a hand-run command, an SSH session, a tool started
    by something that does not inherit the login environment - the user's own runtime directory is
    used if it exists, because that is where the *services* put these files, and agreeing with the
    running services matters more than the old habit of falling back to /tmp. A daemon that is
    plainly running must not be reported as absent because the caller's environment was thin.
    """
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if not runtime:
        candidate = "/run/user/%d" % os.getuid()
        runtime = candidate if os.path.isdir(candidate) else "/tmp"
    return os.path.join(runtime, name)


def button_mode():
    """'auto', 'visuals' or 'sdk' - read from the file the tool and the CLI write."""
    try:
        mode = (config_dir() / BUTTON_MODE_FILE).read_text().strip().lower()
    except OSError:
        return "auto"
    return mode if mode in BUTTON_MODES else "auto"


def set_button_mode(mode):
    path = config_dir() / BUTTON_MODE_FILE
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(mode.strip().lower() + "\n")


def sdk_client_present(now=None, runtime=None):
    """Whether a Logitech-LCD-SDK client - a game, an applet, the Windows bridge - is drawing.

    A file that has gone stale means the client died without shutting down, so it counts as
    gone: otherwise one crash would leave the pad deaf to its own buttons for good.
    """
    moment = time.time() if now is None else now
    path = os.path.join(runtime or runtime_path(""), SDK_CLIENT_FILE)
    try:
        return moment - os.stat(path).st_mtime <= SDK_CLIENT_FRESH_SECONDS
    except OSError:
        return False


def should_pause(mode, client_present):
    """Whether the visuals should keep their hands off the screen and the four buttons.

    auto    - yes while an SDK client is connected, no when it is not
    visuals - never: the menu keeps the screen and the buttons
    sdk     - always: an SDK client owns them whether or not one is connected
    """
    if mode == "sdk":
        return True
    if mode == "visuals":
        return False
    return bool(client_present)


def screen_state(mode, client_present, paused):
    """A few extra values, so the config tool can say who has the screen."""
    return {"button_mode": mode, "sdk_client": client_present,
            "screen_owner": "sdk" if paused else "visuals"}


def publish_values(values):
    """The live values on their own, for when the screen is not ours to draw."""
    try:
        with open(runtime_path("g13-values.json"), "w") as handle:
            json.dump(values, handle, indent=2, sort_keys=True)
    except OSError:
        pass


def publish(lines, values):
    """Publishes what is on the screen, and the live values, for the config tool.

    The tool cannot read the panel, so this is how its preview shows the real thing and
    how the applet designer previews a design against live data.
    """
    try:
        with open(runtime_path("g13-screen"), "w") as handle:
            handle.write("\n".join(lines) + "\n")
    except OSError:
        pass
    publish_values(values)


def source_age(spec, now=None):
    """How long ago the file behind a data source was written, in seconds, or None.

    Only files have an age: `json:` and `file:` are read from disk, `cmd:` is run, and the
    rest come from the machine itself.
    """
    if ":" not in spec:
        return None
    scheme, rest = spec.split(":", 1)
    if scheme not in ("json", "file"):
        return None
    path = rest.split("#", 1)[0]
    try:
        written = os.stat(os.path.expanduser(path)).st_mtime
    except OSError:
        return None

    reference = time.time() if now is None else now
    age = reference - written
    if age < -60:
        # The reference is not a wall clock - the run loop's timer is monotonic, and mixing the
        # two makes every file look billions of seconds young, so nothing would ever go stale.
        age = time.time() - written
    return max(0.0, age)


class Follower:
    """Lets a visual fed by a running program take the screen, and hand it back.

    A game HUD is only interesting while the game is running. The applet says so - "follow":
    {"seconds": 20} - and the daemon watches the files behind its own live sources: while one
    of them is being written, the applet is what is on the screen, and when the writing stops
    the screen goes back to whatever was showing before.

    Choosing something else while it is running is respected: this saves a button press, it
    does not fight you. Following starts again the next time the program runs.
    """

    def __init__(self):
        self.following = None          # the applet that took the screen
        self.previous = None           # what to give it back to
        self.suppressed = False        # you picked something else while it was running
        self.live = []                 # applets being written to right now
        self.stopped = None            # the applet that just went quiet, for the log

    def live_applets(self, engine, now, age=source_age):
        names = []
        for name in engine.enabled:
            visual = engine.visuals.get(name)
            seconds = getattr(visual, "follow_seconds", lambda: 0)()
            if not seconds:
                continue
            for spec in visual.sources():
                age_of = age(spec, now)
                if age_of is not None and age_of <= seconds:
                    names.append(name)
                    break
        return names

    def wanted(self, engine, now, age=source_age):
        """Which visual should be showing, or None to leave things alone."""
        self.live = self.live_applets(engine, now, age)
        self.stopped = None

        if self.following and self.following not in self.live:
            self.stopped = self.following
            back = self.previous if self.previous in engine.enabled else engine.enabled[0]
            self.following = self.previous = None
            self.suppressed = False
            return back if back != engine.active else None

        if not self.live:
            self.following = self.previous = None
            self.suppressed = False
            return None

        if self.following or self.suppressed:
            return None
        if engine.active in self.live:
            # Already showing it; remember, so it can be handed back later.
            self.following = engine.active
            return None

        self.previous = engine.active
        self.following = self.live[0]
        return self.following

    def user_chose(self, name):
        """Called when the active visual changed for a reason that was not this."""
        if self.following and name != self.following:
            self.suppressed = True


def reloaded(engine, fresh):
    """The engine to carry on with after the files changed on disk.

    config_supersedes answers "has the config file something to say that the running state does not
    already do?". When what changed is an applet's own file, or a source switched on or off, the
    answer is no - the active choice has not moved - but the drawings still have to come from the
    files as they are now, or an edit would never reach the pad. So the fresh drawings are adopted
    either way, and only which visual is showing is the config's to decide.

    Returns the engine to carry on with; it is the fresh one when the config has spoken.
    """
    if config_supersedes(engine, fresh):
        return fresh
    engine.visuals = fresh.visuals
    return engine


def config_supersedes(engine, fresh):
    """Whether a freshly read config file should replace the running engine.

    The file is the shared truth - which visuals exist, the order, the cycle settings, and
    which one is showing. The daemon writes its own changes (G24, the menu) back into that
    same file, so adopting it never fights the device. An earlier version kept the running
    visual whenever it was still enabled, which quietly made a change made anywhere else -
    the config tool's "Show now" - do nothing at all.
    """
    return (fresh.active != engine.active
            or fresh.snapshot() != engine.snapshot()
            or set(fresh.visuals) != set(engine.visuals))


CLI_HELP = """g13-visuals - the pad's screen.

    g13-visuals                    run the daemon: this is what the service does
    g13-visuals --list             what can be shown, and what is switched on
    g13-visuals --select NAME      show this one now, switching it on if it is off
    g13-visuals --enable NAME      add it to the ones the pad cycles through
    g13-visuals --disable NAME     take it out of them
    g13-visuals --status           what is showing, who owns the screen, is the daemon up
    g13-visuals --sources          what data applets may read, and what is switched off
    g13-visuals --enable-source K  let applets read that kind of source again
    g13-visuals --disable-source K stop them: built-in, env, file, json, cmd, http, regex, mqtt, ws, imap
    g13-visuals --read SPEC        read one source, exactly as an applet would see it
                                   (put a text-log pattern in quotes: --read 'regex:/tmp/x.log#hp=(\\d+)')

NAME is a visual's name (clock, system, media, pad, custom), an applet (applet:cp2077-hud, or
just cp2077-hud), or a title as it appears on the pad.

Everything here edits the same visuals.json the daemon reads about once a second, so nothing
talks to a running daemon and none of it needs one: a change made with no daemon running is what
it shows the next time it starts.
"""


def applet_files(directory=None):
    """{visual name: file} for the applets on disk.

    A file's name and the name inside it can differ - `example-stats.json` calls itself
    `demo-stats` - and the file is what somebody types, so both have to be answerable.
    """
    files = {}
    for path in sorted((directory or applet_dir()).glob("*.json")):
        try:
            definition = json.loads(path.read_text())
            name = definition.get("name") or path.stem
        except (OSError, ValueError, AttributeError):
            name = path.stem
        files[APPLET_PREFIX + str(name)] = path
    return files


def find_visual(name, visuals, files=None):
    """A visual by its name, its applet's file name, or its title as shown on the pad."""
    files = applet_files() if files is None else files
    for candidate in (name, APPLET_PREFIX + name):
        if candidate in visuals:
            return candidate
    for visual_name, path in files.items():
        if visual_name in visuals and name in (path.stem, path.name):
            return visual_name
    for visual_name in visuals:
        if visual_name.split(":")[-1] == name:
            return visual_name
    titled = [candidate for candidate in visuals
              if str(getattr(visuals[candidate], "title", "")).lower() == name.lower()]
    return titled[0] if len(titled) == 1 else None


def near_misses(name, visuals):
    """Names close enough to be what somebody meant, for the error message."""
    lowered = name.lower()
    return sorted(candidate for candidate in visuals
                  if lowered in candidate.lower() or candidate.split(":")[-1].lower() in lowered)


def published_state():
    """What the running daemon last published, and how long ago, or ({}, None) if it is not."""
    path = runtime_path("g13-values.json")
    try:
        age = time.time() - os.stat(path).st_mtime
        return json.loads(Path(path).read_text()), age
    except (OSError, ValueError):
        return {}, None


def cli_list(visuals, values):
    config = read_config()
    enabled = config.get("enabled") or list(visuals)
    active = config.get("active")
    files = applet_files()
    for name in sorted(visuals, key=lambda item: (item not in enabled, str(item))):
        path = files.get(name)
        showed_as = ""
        if path and path.stem != name.split(":")[-1]:
            showed_as = "  (%s)" % path.name
        print("  %s %-22s %-24s %-4s%s" % ("*" if name == active else " ", name,
                                           str(getattr(visuals[name], "title", ""))[:24],
                                           "on" if name in enabled else "off", showed_as))
    print()
    print("  %d of %d switched on; showing %s"
          % (len([name for name in visuals if name in enabled]), len(visuals),
             active or "nothing"))
    return 0


def cli_sources(visuals, values):
    """What data applets may read, and what each kind is for."""
    off = disabled_kinds()
    for kind, why in SOURCE_KINDS:
        print("  %-10s %-4s %s" % (kind, "off" if kind in off else "on", why))
    print()
    if off:
        print("  applets asking for %s read an empty value, not an error" % ", ".join(off))
    else:
        print("  everything an applet can ask for is switched on")
    if "built-in" not in off:
        print("  right now:  cpu %s%%   time %s   date %s"
              % (round(float(values.raw("cpu"))), values.raw("time"), values.raw("date")))
    return 0


def cli_read(spec, values):
    """Prints one source, exactly as an applet would see it.

    This is what the sources window's Test button runs, so an endpoint is proved by the code that
    will read it on the pad rather than by a second opinion about how to fetch a web address.
    """
    kind = source_kind(spec)
    print("  %s" % spec)
    if kind in values.blocked_kinds():
        print("  empty: the %s kind is switched off in the sources window" % kind)
        return 0

    value = values.raw(spec)
    print("  -> %r" % value)
    if value != "":
        return 0

    print("  empty: nothing there, or nothing readable. An applet would show blank.")
    if kind == "http":
        endpoint, _path, _field = split_http(spec)
        if endpoint not in values.endpoints():
            print("  no endpoint called %r in %s - a web address is named there, with its token,"
                  % (endpoint, config_dir() / ENDPOINTS_FILE))
            print("  so that an applet can carry the name and not the credential.")
    return 0


def cli_status(visuals, values):
    config = read_config()
    published, age = published_state()
    active = config.get("active")
    title = getattr(visuals.get(active), "title", "")
    enabled = [name for name in visuals
               if name in (config.get("enabled") or list(visuals))]

    mode = button_mode()
    present = sdk_client_present()
    owner = published.get("screen_owner") or ("sdk" if should_pause(mode, present) else "visuals")
    print("  showing:   %s%s" % (active or "nothing", "  (%s)" % title if title else ""))
    print("  switched:  %d of %d on%s"
          % (len(enabled), len(visuals),
             ", cycling every %.0fs" % float(config.get("cycle_seconds", 10))
             if config.get("cycle") else ", cycling off"))
    print("  screen:    %s   (button mode '%s', %s)"
          % ("an SDK client" if owner == "sdk" else "the visuals", mode,
             "a client is connected" if present else "no client connected"))
    off = disabled_kinds()
    if off:
        print("  sources:   %s switched off for applets" % ", ".join(off))
    if age is None:
        print("  daemon:    not running (nothing published at %s)"
              % runtime_path("g13-values.json"))
    else:
        print("  daemon:    running, last drew %.1fs ago" % age)
    return 0


def set_enabled(name, on, visuals):
    """Switches a visual on or off, and moves the showing one if it was switched off."""
    config = read_config()
    was_showing = config.get("active") == name
    enabled = [item for item in (config.get("enabled") or list(visuals)) if item != name]
    if on:
        enabled.append(name)
    config["enabled"] = enabled
    if config.get("active") not in enabled:
        config["active"] = enabled[0] if enabled else config.get("active")
    write_config(config)
    print("  %s is %s" % (name, "switched on" if on else "switched off"))
    if not on and was_showing:
        print("  (it was showing, so the screen moves to %s)" % config.get("active"))
    return 0


def cli_select(name, visuals):
    config = read_config()
    enabled = config.get("enabled") or list(visuals)
    if name not in enabled:
        print("  %s was switched off; switching it on so it stays" % name)
        set_enabled(name, True, visuals)
        config = read_config()
    config["active"] = name
    write_config(config)
    _, age = published_state()
    print("  showing %s" % name)
    if age is None:
        print("  (no daemon is running; this is what it shows when one is)")
    return 0


def answer(argv, visuals, values):
    """Answers the command line. Returns an exit code."""
    words = list(argv)
    if words[0] in ("-h", "--help", "help"):
        print(CLI_HELP, end="")
        return 0

    action = words[0].lstrip("-")
    arguments = words[1:]

    if action == "list" and not arguments:
        return cli_list(visuals, values)
    if action == "status" and not arguments:
        return cli_status(visuals, values)
    if action == "sources" and not arguments:
        return cli_sources(visuals, values)

    if action == "read":
        if len(arguments) != 1:
            print("usage: g13-visuals --read SPEC", file=sys.stderr)
            return 2
        return cli_read(arguments[0], values)

    if action in ("enable-source", "disable-source"):
        kinds = [name for name, _why in SOURCE_KINDS]
        if len(arguments) != 1:
            print("usage: g13-visuals --%s KIND" % action, file=sys.stderr)
            return 2
        try:
            off = set_kind_enabled(arguments[0], action == "enable-source")
        except ValueError as error:
            print("%s. Kinds: %s" % (error, ", ".join(kinds)), file=sys.stderr)
            return 1
        print("  applets may %s read %s" % ("now" if action == "enable-source" else "no longer",
                                            arguments[0]))
        if off:
            print("  still switched off: %s" % ", ".join(off))
        return 0

    if action in ("select", "enable", "disable"):
        if len(arguments) != 1:
            print("usage: g13-visuals --%s NAME" % action, file=sys.stderr)
            return 2
        name = find_visual(arguments[0], visuals)
        if name is None:
            print("no visual called %r. Try --list." % arguments[0], file=sys.stderr)
            close = near_misses(arguments[0], visuals)
            if close:
                print("  did you mean: %s" % ", ".join(close[:6]), file=sys.stderr)
            return 1
        return cli_select(name, visuals) if action == "select" else set_enabled(
            name, action == "enable", visuals)

    print("g13-visuals: %r is not a command. Try --help." % words[0], file=sys.stderr)
    return 2


def run_or_answer(argv):
    """Answers argv, or returns None to mean: no command line, so be the daemon."""
    if not argv:
        return None
    values = Values()
    return answer(argv, registry(values), values)


def config_stamp_now():
    """What the daemon watches for changes: the config file, and every applet file.

    An applet is a file of its own, so editing one has to bring the screen up to date even when
    visuals.json has not moved - otherwise saving in the designer would only show on the pad after
    a restart.

    Each applet is watched by name, size and mtime rather than by watching the applets directory.
    Writing to a file that is already in a directory does *not* move the directory's own mtime -
    only adding, removing or renaming an entry does - so a directory watch sees an edit as no
    change at all, which is exactly how a designer save went unnoticed.
    """
    stamps = []
    watched = [config_dir() / "visuals.json", config_dir() / SOURCES_FILE,
               config_dir() / ENDPOINTS_FILE]
    try:
        watched += sorted(applet_dir().glob("*.json"))
    except OSError:
        pass
    for path in watched:
        try:
            info = path.stat()
            stamps.append((path.name, info.st_mtime, info.st_size))
        except OSError:
            stamps.append((path.name, None, None))
    return tuple(stamps)


def main():
    values = Values()
    try:
        visuals = registry(values)
    except Exception as error:  # a broken applet must not stop the pad from working
        print("g13-visuals: falling back to the built-in visuals: %s: %s"
              % (type(error).__name__, error), flush=True)
        visuals = {visual.name: visual for visual in VISUALS}
    engine = Engine(read_config(), visuals=visuals, values=values)

    config_stamp = None
    last_poll = 0.0
    last_follow = 0.0
    last_drawn = 0.0
    dirty = True
    shown_state = None
    follower = Follower()

    while True:
        # --- the driver's event socket, reconnecting as needed ---
        try:
            connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            connection.settimeout(0.2)
            connection.connect(str(socket_path()))
        except OSError:
            time.sleep(RECONNECT_SECONDS)
            last_poll = 0.0
            continue

        print("g13-visuals: connected to %s, showing '%s'" % (socket_path(), engine.active), flush=True)
        pending = b""
        paused = None
        last_state_published = 0.0

        while True:
            # Who has the screen and the four buttons beside it. A mode the user set, and
            # whether an SDK client is actually drawing.
            mode = button_mode()
            client_present = sdk_client_present()
            pause = should_pause(mode, client_present)
            if pause != paused:
                paused = pause
                print("g13-visuals: %s" % (
                    "an SDK client has the screen and the four buttons ('%s')" % mode
                    if pause else
                    "the visuals have the screen and the four buttons ('%s')" % mode),
                    flush=True)

            try:
                chunk = connection.recv(4096)
            except socket.timeout:
                chunk = None
            except OSError:
                chunk = b""

            if chunk == b"":
                break  # Driver went away; reconnect.

            if chunk:
                pending += chunk
                while b"\n" in pending:
                    line, pending = pending.split(b"\n", 1)
                    fields = line.decode(errors="replace").split()
                    if len(fields) >= 3 and fields[0] == "key":
                        # While an SDK client owns the buttons, they are its input to read.
                        if not paused:
                            engine.on_key(int(fields[1]), fields[2] != "0")
                        dirty = True
                    elif len(fields) >= 3 and fields[0] == "state":
                        engine.on_state(fields[1], fields[2])
                        dirty = True

            now = time.monotonic()

            # --- pick up applets and config changes made elsewhere (the config tool) ---
            if now - last_poll >= CONFIG_POLL_SECONDS:
                last_poll = now
                stamp = config_stamp_now()

                if stamp != config_stamp:
                    config_stamp = stamp
                    try:
                        fresh_visuals = registry(values)
                    except Exception as error:
                        print("g13-visuals: keeping the current visuals, reloading failed: %s: %s"
                              % (type(error).__name__, error), flush=True)
                        fresh_visuals = engine.visuals
                    fresh = Engine(read_config(), clock=engine.clock,
                                   visuals=fresh_visuals, values=values)
                    # The file is the shared truth, including which visual is showing - and when
                    # what changed is an applet rather than the active choice, the new drawings are
                    # taken while the visual on the pad stays where it is.
                    replaced = reloaded(engine, fresh)
                    if replaced is not engine:
                        follower.user_chose(fresh.active)
                    engine = replaced
                    dirty = True

            # --- a program that is running behind an applet gets the screen, and gives ---
            # --- it back when it stops                                                  ---
            if now - last_follow >= CONFIG_POLL_SECONDS:
                last_follow = now
                wanted = follower.wanted(engine, now)
                if wanted and wanted != engine.active:
                    engine.switch_to(wanted)
                    dirty = True
                    if follower.stopped:
                        print("g13-visuals: '%s' stopped, going back to '%s'"
                              % (follower.stopped, wanted), flush=True)
                    else:
                        print("g13-visuals: '%s' is being written to, showing it" % wanted,
                              flush=True)

            # --- draw when the visual asks for it, or straight after a button ---
            if not paused and (dirty or now - last_drawn >= engine.interval()):
                lines = engine.tick()
                g13lcd.send(lines)

                sources = list(PUBLISHED_SOURCES)
                active = engine.visuals.get(engine.active)
                if isinstance(active, LayoutVisual):
                    sources += [source for source in active.sources()
                                if not source.startswith("cmd:")]
                published = values.all(sources)
                published.update(screen_state(mode, client_present, False))
                publish(lines, published)

                last_drawn = now
                if shown_state != engine.snapshot():
                    shown_state = engine.snapshot()
                    write_config(shown_state)
                dirty = False

            elif paused and now - last_state_published >= 1.0:
                # Keep the values current while an SDK client has the screen: the tool shows
                # who owns it from these, and a stale file would say the wrong thing.
                last_state_published = now
                state = values.all(PUBLISHED_SOURCES)
                state.update(screen_state(mode, client_present, True))
                publish_values(state)


if __name__ == "__main__":
    try:
        code = run_or_answer(sys.argv[1:])
        if code is None:
            main()
        else:
            sys.exit(code)
    except KeyboardInterrupt:
        pass
