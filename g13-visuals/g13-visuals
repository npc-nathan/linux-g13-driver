class SystemVisual:
    name = "system"
    title = "SYSTEM"
    interval = 2.0

    def __init__(self):
        self.previous = None

    def cpu_percent(self):
        """Busy share of the cpu since the last look."""
        with open("/proc/stat") as handle:
            fields = [int(value) for value in handle.readline().split()[1:]]
        idle = fields[3] + fields[4]
        total = sum(fields)

        if self.previous is None:
            self.previous = (idle, total)
            return 0

        idle_delta = idle - self.previous[0]
        total_delta = total - self.previous[1]
        self.previous = (idle, total)
        if total_delta <= 0:
            return 0
        return int(100 * (total_delta - idle_delta) / total_delta)

    def memory_percent(self):
        values = {}
        with open("/proc/meminfo") as handle:
            for line in handle:
                key, _, rest = line.partition(":")
                values[key] = int(rest.split()[0])
        total = values.get("MemTotal", 1)
        available = values.get("MemAvailable", 0)
        return int(100 * (total - available) / total)

    def render(self, screen, context):
        usage = self.cpu_percent()
        memory = self.memory_percent()
        with open("/proc/loadavg") as handle:
            load = float(handle.read().split()[0])
        with open("/proc/uptime") as handle:
            uptime = float(handle.read().split()[0])

        screen.frame_and_title(self.title)
        for row, (label, percent) in enumerate((("CPU", usage), ("MEM", memory))):
            y = 12 + row * 10
            screen.text(3, y, label)
            screen.bar(28, y, 88, 8, percent)
            screen.text(122, y, "%3d%%" % percent)

        hours = int(uptime // 3600)
        screen.text(3, 33, "LOAD %.2f   UP %dh%02dm" % (load, hours, int(uptime % 3600) // 60))


class MediaVisual:
    name = "media"
    title = "MEDIA"
    interval = 1.0

    def metadata(self):
        """What the running media player reports, or None."""
        try:
            result = subprocess.run(
                ["playerctl", "metadata", "--format",
                 "{{status}}|{{artist}}|{{title}}|{{position}}|{{mpris:length}}"],
                capture_output=True, text=True, timeout=0.5)
        except (OSError, subprocess.SubprocessError):
            return None

        if result.returncode != 0 or not result.stdout.strip():
            return None
        parts = (result.stdout.strip().split("|") + [""] * 5)[:5]
        return parts

    def render(self, screen, context):
        screen.frame_and_title(self.title)
        data = self.metadata()

        if data is None:
            screen.text(centred("no player"), 18, "no player")
            return

        status, artist, title, position, length = data
        playing = "playing" if status == "Playing" else status.lower() or "stopped"
        screen.text(3, 12, (title or "unknown")[:24])
        screen.text(3, 21, (artist or "")[:24])

        try:
            done = int(position) // 1_000_000
            total = int(length) // 1_000_000
        except (TypeError, ValueError):
            done, total = 0, 0

        percent = int(100 * done / total) if total else 0
        screen.bar(3, 32, 110, 8, percent)
        screen.text(118, 32, ("%d:%02d" % (done // 60, done % 60)) if total else playing)


class PadVisual:
    name = "pad"
