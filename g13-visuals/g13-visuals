def field_of(data, field):
    """One field out of parsed JSON: dotted for nesting, a number for a list index.

    Shared by `json:` (a file something else writes) and `http:` (a web address), so a field path
    means the same thing whichever way the data arrived - `#hud.ammo`, `#route.0`, `#state`.
    """
    for part in field.split("."):
        if isinstance(data, dict) and part in data:
            data = data[part]
        elif isinstance(data, list) and part.lstrip("-").isdigit():
            index = int(part)
            data = data[index] if -len(data) <= index < len(data) else ""
        else:
            return ""
    return data if isinstance(data, (int, float, str, bool)) else ""


def split_http(spec):
    """`http:<endpoint>/<path>#<field>`, or a whole `http://host/path#<field>` address.

    Returns the endpoint name (or host), the path, and the field. The endpoint is a name from
    endpoints.json, where its address and any credential live; a whole address is allowed too, for
    something public that needs no credential.
    """
    rest = spec[len("http:"):]
    if rest.startswith("//"):
        rest = "http:" + rest              # somebody wrote http://host/...
    if rest.startswith("http://") or rest.startswith("https://"):
        address, separator, field = rest.rpartition("#")
        if not separator:
            address, field = rest, ""
        scheme, _, host_and_path = address.partition("://")
        host, slash, tail = host_and_path.partition("/")
        return scheme + "://" + host, (tail if slash else ""), field
    address, separator, field = rest.rpartition("#")
    if not separator:
        address, field = rest, ""
    endpoint, slash, tail = address.partition("/")
    return endpoint, (tail if slash else ""), field


def shell(command, timeout=0.4):
    """Runs a command for its output, or None if it fails or takes too long."""
    try:
        result = subprocess.run(command, shell=True, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.SubprocessError):
        return None
    if result.returncode != 0:
        return None
    return result.stdout.strip()


# ---------------------------------------------------------------- mqtt
#
# `mqtt:<endpoint>/<topic>#<field>` shows the last thing published on a topic. A broker is just an
# address, so it is named in endpoints.json like any other, with an `mqtt://` scheme and with any
# username and password there rather than in an applet:
#
#   { "home": { "url": "mqtt://homeassistant.local:1883", "user": "g13", "token": "..." } }
#
# One connection per broker, one thread each, one subscription per topic an applet actually asks
# for. Messages are kept as they arrive, so asking for a value is instant and the drawing thread
# never waits on a broker that has gone away: a value is simply empty until the first message lands.
# `mqtts://` is TLS. As with every other source here, anything that goes wrong reads as empty.

MQTT_KEEPALIVE = 30


def read_mqtt_length(stream):
    """MQTT's variable-length integer: up to four bytes, seven bits each, high bit continues."""
    value, shift = 0, 0
    while True:
        byte = stream.read(1)
        if not byte:
            return None
        value |= (byte[0] & 0x7F) << shift
        if not byte[0] & 0x80:
            return value
        shift += 7
        if shift > 21:
            return None


def encode_mqtt_length(length):
    out = bytearray()
    while True:
        byte = length % 128
        length //= 128
        if length:
            byte |= 0x80
        out.append(byte)
        if not length:
            return bytes(out)


class MqttBroker:
    """One broker: connects when a topic is first asked for, keeps the last message per topic."""

    def __init__(self, name, url, user="", token=""):
        self.name = name
        self.host, self.port, self.secure = self._address(url)
        self.user = user
        self.token = token
        self.last = {}                  # topic -> payload
        self.armed = set()              # topics an applet has asked for
        self.buffer = b""
        self.connected = False
        self.thread = None
        self.lock = threading.Lock()

    @staticmethod
    def _address(url):
        """`mqtt://host:1883`, `mqtts://host`, or a bare host, with the usual default ports."""
        rest, secure = url, False
        for scheme in ("mqtt://", "mqtts://", "tcp://", "ssl://"):
            if rest.startswith(scheme):
                secure = scheme in ("mqtts://", "ssl://")
                rest = rest[len(scheme):]
                break
        rest = rest.rstrip("/")
        host, _, port = rest.partition(":")
        return host, int(port) if port.isdigit() else (8883 if secure else 1883), secure

    def ask_for(self, topic):
        """An applet wants this topic: remember it, and connect if we are not already trying."""
        with self.lock:
            if topic in self.armed:
                return
            self.armed.add(topic)
        if self.thread is None or not self.thread.is_alive():
            self.thread = threading.Thread(target=self._run, name="mqtt-%s" % self.name, daemon=True)
            self.thread.start()

    def payload(self, topic):
        with self.lock:
            return self.last.get(topic, "")

    def _packet(self, kind, body):
        return bytes([kind]) + encode_mqtt_length(len(body)) + body

    def _connect_packet(self):
        flags, payload = 0x02, bytearray()               # clean session
        client_id = ("g13-visuals-%d" % os.getpid()).encode()
        for item in (client_id, self.user.encode() if self.user else None,
                     self.token.encode() if self.token else None):
            if item:
                payload += len(item).to_bytes(2, "big") + item
        if self.user:
            flags |= 0x80                                # a username follows
        if self.token:
            flags |= 0x40                                # so does a password
        head = bytearray(b"\x00\x04MQTT\x04")
        head.append(flags)
        head += MQTT_KEEPALIVE.to_bytes(2, "big")
        return self._packet(0x10, bytes(head) + bytes(payload))

    def _subscribe_packet(self, topic, packet_id):
        body = packet_id.to_bytes(2, "big") + len(topic).to_bytes(2, "big") + topic.encode() + b"\x00"
        return self._packet(0x82, body)

    def _read_exact(self, sock, count):
        """Exactly `count` bytes, or None when the broker is quiet for a whole timeout.

        Returns None rather than blocking, so the loop gets a chance to subscribe to a topic that
        was asked for while we sat here and to send a keepalive - a broker that says nothing must
        not stop us hearing about a new topic, nor get us disconnected for silence.
        """
        while len(self.buffer) < count:
            try:
                chunk = sock.recv(4096)
            except socket.timeout:
                return None
            if not chunk:
                return None
            self.buffer += chunk
        out, self.buffer = self.buffer[:count], self.buffer[count:]
        return out

    def _read_length(self, sock):
        """MQTT's variable-length integer, read a byte at a time."""
        value, shift = 0, 0
        while True:
            byte = self._read_exact(sock, 1)
            if byte is None:
                return None
            value |= (byte[0] & 0x7F) << shift
            if not byte[0] & 0x80:
                return value
            shift += 7
            if shift > 21:
                return None

    def _run(self):
        """The broker's thread: connect, subscribe to whatever is wanted, keep up, reconnect."""
        attempt = 0
        while True:
            try:
                with self.lock:
                    wanted = sorted(self.armed)
                if not wanted:
                    time.sleep(0.25)
                    continue
                sock = socket.create_connection((self.host, self.port), timeout=6)
                if self.secure:
                    sock = ssl.create_default_context().wrap_socket(sock, server_hostname=self.host)
                sock.settimeout(1.0)                     # a quiet second is not a failure
                self.buffer = b""
                sock.sendall(self._connect_packet())
                answer = self._read_exact(sock, 4)
                if not answer or answer[3] != 0:
                    raise OSError("broker refused the connection")
                self.connected, attempt = True, 0
                with self.lock:
                    wanted = sorted(self.armed)
                sent, packet_id = set(), 1
                for topic in wanted:
                    sock.sendall(self._subscribe_packet(topic, packet_id))
                    packet_id += 1
                    sent.add(topic)
                last_ping = time.monotonic()
                while True:
                    with self.lock:
                        missing = sorted(self.armed - sent)
                    for topic in missing:                # asked for since we connected
                        sock.sendall(self._subscribe_packet(topic, packet_id))
                        packet_id += 1
                        sent.add(topic)
                    header = self._read_exact(sock, 1)
                    if header is None:                   # nothing arrived: ping if it is due, and
                        if time.monotonic() - last_ping > MQTT_KEEPALIVE / 2:
                            sock.sendall(b"\xc0\x00")   # then go round again to catch new topics
                            last_ping = time.monotonic()
                        continue
                    length = self._read_length(sock)
                    body = self._read_exact(sock, length) if length else b""
                    if header[0] >> 4 == 3 and body and len(body) > 2:      # PUBLISH
                        topic_length = int.from_bytes(body[0:2], "big")
                        topic = body[2:2 + topic_length].decode("utf-8", "replace")
                        with self.lock:
                            self.last[topic] = body[2 + topic_length:].decode("utf-8", "replace")
            except (OSError, ssl.SSLError, ValueError):
                self.connected = False
                attempt += 1
                time.sleep(min(30, 2 ** min(attempt, 5)))
                if attempt > 20:                     # give up quietly; asking again starts it over
                    return

    def value(self, topic, field):
        raw = self.payload(topic)
        if not raw or not field:
            return raw
        try:
            return field_of(json.loads(raw), field)
        except (ValueError, TypeError):
            return ""


MQTT_BROKERS = {}


def mqtt_broker_for(name, entries):
    """The broker `<name>` means, from the same endpoints.json that `http:` uses.

    An entry counts as a broker only if its address says so, so one file holds web addresses and
    brokers together and the scheme decides which is which.
    """
    if name in MQTT_BROKERS:
        return MQTT_BROKERS[name]
    entry = entries.get(name)
    if not isinstance(entry, dict):
        return None
    url = str(entry.get("url", ""))
    if not url.startswith(("mqtt://", "mqtts://", "tcp://", "ssl://")):
        return None
    broker = MqttBroker(name, url, str(entry.get("user", "")), str(entry.get("token", "")))
    MQTT_BROKERS[name] = broker
    return broker


def mqtt_value(spec, entries):
    """`mqtt:<endpoint>/<topic>#<field>` -> the last message on that topic, or empty.

    Instant: it answers with whatever has arrived and asks the broker to start sending that topic.
    Nothing here ever waits, which is what keeps a slow or absent broker from holding up the screen.
    """
    rest = spec[len("mqtt:"):]
    address, separator, field = rest.rpartition("#")
    if not separator:
        address, field = rest, ""
    endpoint, slash, topic = address.partition("/")
    if not slash or not topic:
        return ""
    broker = mqtt_broker_for(endpoint, entries)
    if broker is None:
        return ""
    broker.ask_for(topic)
    return broker.value(topic, field)


# ---------------------------------------------------------------- web sockets
#
# `ws:<endpoint>#<field>` shows the last message that arrived on a web socket. That is the only
# interface some things have: obs-websocket, Home Assistant's event stream, a live feed. As with
# `http:` and `mqtt:`, the address lives in endpoints.json, so a URL and a password never appear in
# an applet:
#
#   { "obs": { "url": "ws://127.0.0.1:4455", "subscribe": "{\"op\":1,\"d\":{...}}", "ping": "" } }
#
# Two optional fields: `subscribe`, sent once as soon as the socket opens (which is how these
# servers are told what to send, since a web socket itself has no notion of a subscription - unlike
# MQTT, every one of them invents its own), and `ping`, sent every half a keepalive to keep a server
# that expects to hear from us happy. `wss://` is TLS.
#
# One socket per endpoint on its own thread, the newest text message kept, and anything unexpected -
# no such endpoint, refused, closed, a payload that is not JSON, a field that is not there - reads
# as empty. The handshake and the frame format are implemented here rather than pulled in, because
# they are a page of code and this driver has no dependencies.

WS_GUID = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
WS_KEEPALIVE = 20
WS_OPEN_TIMEOUT = 6


def ws_frame(payload, opcode=0x1):
    """A masked client frame: the mask is required in this direction by the protocol."""
    body = payload.encode() if isinstance(payload, str) else payload
    mask = os.urandom(4)
    masked = bytes(byte ^ mask[index % 4] for index, byte in enumerate(body))
    length = len(body)
    if length < 126:
        header = bytes([0x80 | opcode, 0x80 | length])
    elif length < 65536:
        header = bytes([0x80 | opcode, 0x80 | 126]) + length.to_bytes(2, "big")
    else:
        header = bytes([0x80 | opcode, 0x80 | 127]) + length.to_bytes(8, "big")
    return header + mask + masked


class WsClient:
    """One web socket: opens when a field is first asked for, keeps the newest message."""

    def __init__(self, name, url, subscribe="", ping="", token=""):
        self.name = name
        self.host, self.port, self.path, self.secure = self._address(url)
        self.subscribe = subscribe or ""
        self.ping = ping or ""
        self.token = token
        self.last = ""
        self.armed = False
        self.connected = False
        self.thread = None
        self.lock = threading.Lock()

    @staticmethod
    def _address(url):
        rest, secure = url, False
        for scheme in ("ws://", "wss://", "http://", "https://"):
            if rest.startswith(scheme):
                secure = scheme in ("wss://", "https://")
                rest = rest[len(scheme):]
                break
        host_and_path = rest.split("/", 1)
        host, path = host_and_path[0], "/" + (host_and_path[1] if len(host_and_path) > 1 else "")
        host, _, port = host.partition(":")
        return host, int(port) if port.isdigit() else (443 if secure else 80), path, secure

    def ask(self):
        with self.lock:
            if self.armed:
                return
            self.armed = True
        self.thread = threading.Thread(target=self._run, name="ws-%s" % self.name, daemon=True)
        self.thread.start()

    def message(self):
        with self.lock:
            return self.last

    def _handshake(self, sock):
        key = base64.b64encode(os.urandom(16)).decode()
        host = self.host if self.port in (80, 443) else "%s:%d" % (self.host, self.port)
        request = ("GET %s HTTP/1.1\r\nHost: %s\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
                   "Sec-WebSocket-Key: %s\r\nSec-WebSocket-Version: 13\r\n\r\n"
                   % (self.path, host, key))
        sock.sendall(request.encode())
        answer = b""
        while b"\r\n\r\n" not in answer:
            chunk = sock.recv(4096)
            if not chunk:
                raise OSError("closed during the handshake")
            answer += chunk
            if len(answer) > 16384:
                raise OSError("handshake too long")
        head = answer.split(b"\r\n\r\n", 1)[0].decode("utf-8", "replace")
        if "101" not in head.split("\r\n")[0]:
            raise OSError("server refused the upgrade")
        expected = base64.b64encode(hashlib.sha1((key + WS_GUID).encode()).digest()).decode()
        if expected.lower() not in head.lower():
            raise OSError("server answered with the wrong key")
        return answer.split(b"\r\n\r\n", 1)[1] if b"\r\n\r\n" in answer else b""

    def _read_frame(self, sock, buffered):
        """One frame: (opcode, payload). Handles the three length forms and any leftovers."""
        buffer = bytearray(buffered)
        while len(buffer) < 2:
            chunk = sock.recv(4096)
            if not chunk:
                raise OSError("socket closed")
            buffer += chunk
        opcode = buffer[0] & 0x0F
        masked = buffer[1] & 0x80
        length = buffer[1] & 0x7F
        offset = 2
        while True:
            if length == 126:
                while len(buffer) < offset + 2:
                    buffer += sock.recv(4096)
                length = int.from_bytes(buffer[offset:offset + 2], "big")
                offset += 2
            elif length == 127:
                while len(buffer) < offset + 8:
                    buffer += sock.recv(4096)
                length = int.from_bytes(buffer[offset:offset + 8], "big")
                offset += 8
            break
        if masked:
            while len(buffer) < offset + 4:
                buffer += sock.recv(4096)
            mask = bytes(buffer[offset:offset + 4])
            offset += 4
        while len(buffer) < offset + length:
            chunk = sock.recv(4096)
            if not chunk:
                raise OSError("socket closed mid-frame")
            buffer += chunk
        payload = bytes(buffer[offset:offset + length])
        if masked:
            payload = bytes(byte ^ mask[index % 4] for index, byte in enumerate(payload))
        rest = bytes(buffer[offset + length:])
        return opcode, payload, rest

    def _run(self):
        attempt = 0
        while True:
            try:
                sock = socket.create_connection((self.host, self.port), timeout=WS_OPEN_TIMEOUT)
                if self.secure:
                    sock = ssl.create_default_context().wrap_socket(sock, server_hostname=self.host)
                leftover = self._handshake(sock)
                self.connected, attempt = True, 0
                if self.subscribe:
                    sock.sendall(ws_frame(self.subscribe))
                sock.settimeout(1.0)
                last_sent = time.monotonic()
                while True:
                    if self.ping and time.monotonic() - last_sent > WS_KEEPALIVE / 2:
                        sock.sendall(ws_frame(self.ping))
                        last_sent = time.monotonic()
                    try:
                        opcode, payload, leftover = self._read_frame(sock, leftover)
                    except socket.timeout:
                        continue
                    if opcode == 0x1:                                   # text: what we keep
                        with self.lock:
                            self.last = payload.decode("utf-8", "replace")
                    elif opcode == 0x9:                                 # ping: answer it
                        sock.sendall(ws_frame(payload, opcode=0xA))
                    elif opcode == 0x8:                                 # close
                        raise OSError("server closed the socket")
            except (OSError, ssl.SSLError, ValueError):
                self.connected = False
                attempt += 1
                time.sleep(min(30, 2 ** min(attempt, 5)))
                if attempt > 20:
                    return


WS_CLIENTS = {}


def ws_client_for(name, entries):
    """The web socket `<name>` means, from the same endpoints.json the others use."""
    if name in WS_CLIENTS:
        return WS_CLIENTS[name]
    entry = entries.get(name)
    if not isinstance(entry, dict):
        return None
    url = str(entry.get("url", ""))
    if not url.startswith(("ws://", "wss://")):
        return None
    client = WsClient(name, url, str(entry.get("subscribe", "")), str(entry.get("ping", "")),
                      str(entry.get("token", "")))
    WS_CLIENTS[name] = client
    return client


def ws_value(spec, entries):
    """`ws:<endpoint>#<field>` -> the last message that arrived, or empty. Instant, like mqtt."""
    rest = spec[len("ws:"):]
    address, separator, field = rest.rpartition("#")
    if not separator:
        address, field = rest, ""
    endpoint = address.strip("/")
    if not endpoint:
        return ""
    client = ws_client_for(endpoint, entries)
    if client is None:
        return ""
    client.ask()
    message = client.message()
    if not message or not field:
        return message
    try:
        return field_of(json.loads(message), field)
    except (ValueError, TypeError):
        return ""


# ---------------------------------------------------------------- mail
#
# `imap:<endpoint>/<mailbox>#<field>` shows a mailbox without a mail client: how many are unread,
# or who the newest one is from. The server, the login and the password are named in endpoints.json
# like every other address here, so nothing secret is ever in an applet:
#
#   { "mail": { "url": "imaps://imap.example.com:993", "user": "me@example.com", "token": "..." } }
#
# Fields: `unread` (how many are unseen), `total`, and `from`, `subject`, `date` or `line` for the
# newest message. `unread` comes from a search, `total` from the mailbox itself, and the newest
# message's headers are fetched with PEEK - **nothing here ever marks a message read**, which would
# be a rude thing for a screen to do.
#
# A mailbox cannot be asked every two seconds the way a file can: the result is refreshed on a
# thread once a minute, and a value is whatever the last successful look found. No such endpoint, a
# refused login, a server that is down or a field this does not know all read as empty, exactly
# like everywhere else in this file.

IMAP_CACHE_SECONDS = 60
IMAP_TIMEOUT = 20


def imap_headers(raw):
    """FROM, SUBJECT and DATE out of a FETCH response, with MIME-encoded words decoded.

    `decode_header` is what turns `=?utf-8?B?...?=` back into text; a subject with an accent or a
    name in a script that is not Latin arrives that way, and printing it raw would be a mess.
    """
    text = raw if isinstance(raw, str) else raw.decode("utf-8", "replace")
    found = {}
    for line in text.splitlines():
        for name in ("From", "Subject", "Date"):
            if line.lower().startswith(name.lower() + ":"):
                value = line.split(":", 1)[1].strip()
                try:
                    pieces = email.header.decode_header(value)
                    value = " ".join(piece.decode(charset or "utf-8", "replace")
                                     if isinstance(piece, bytes) else piece
                                     for piece, charset in pieces)
                except (email.errors.HeaderParseError, LookupError, UnicodeDecodeError):
                    pass
                found[name.lower()] = value.strip()
    address = found.get("from", "")
    if address:
        name, mail = email.utils.parseaddr(address)
        found["from"] = name or mail or address
    return found


class ImapMailbox:
    """One mailbox: looked at when first asked for, refreshed once a minute, never marked read."""

    def __init__(self, name, url, user="", token=""):
        self.name = name
        self.host, self.port, self.secure = self._address(url)
        self.user = user
        self.token = token
        self.values = {}
        self.wanted = set()             # (mailbox, field) pairs an applet has asked for
        self.armed = False
        self.thread = None
        self.lock = threading.Lock()

    @staticmethod
    def _address(url):
        rest, secure = url, False
        for scheme in ("imaps://", "imap://", "ssl://"):
            if rest.startswith(scheme):
                secure = scheme in ("imaps://", "ssl://")
                rest = rest[len(scheme):]
                break
        rest = rest.rstrip("/")
        host, _, port = rest.partition(":")
        return host, int(port) if port.isdigit() else (993 if secure else 143), secure

    def ask_for(self, mailbox, field):
        with self.lock:
            self.wanted.add((mailbox, field))
            first = not self.armed
            self.armed = True
        if first:
            self.thread = threading.Thread(target=self._run, name="imap-%s" % self.name, daemon=True)
            self.thread.start()

    def value(self, mailbox, field):
        with self.lock:
            return self.values.get((mailbox, field), "")

    def _look(self, mailbox):
        """One look at a mailbox: (unread, total, headers). Raises on anything unexpected."""
        if self.secure:
            server = imaplib.IMAP4_SSL(self.host, self.port, timeout=IMAP_TIMEOUT)
        else:
            server = imaplib.IMAP4(self.host, self.port, timeout=IMAP_TIMEOUT)
        try:
            server.login(self.user, self.token)
            status, data = server.select(mailbox, readonly=True)
            if status != "OK":
                raise OSError("cannot select %s" % mailbox)
            total = int(data[0]) if data and data[0] else 0
            status, data = server.uid("SEARCH", None, "UNSEEN")
            unread = len(data[0].split()) if status == "OK" and data and data[0] else 0
            headers = {}
            status, data = server.uid("SEARCH", None, "ALL")
            if status == "OK" and data and data[0]:
                newest = data[0].split()[-1]
                status, data = server.uid(
                    "FETCH", newest, "(BODY.PEEK[HEADER.FIELDS (FROM SUBJECT DATE)])")
                if status == "OK" and data and isinstance(data[0], tuple):
                    headers = imap_headers(data[0][1])
            return unread, total, headers
        finally:
            try:
                server.logout()
            except (imaplib.IMAP4.error, OSError):
                pass

    def _run(self):
        while True:
            with self.lock:
                wanted = sorted(self.wanted)
            for mailbox, field in wanted:
                try:
                    unread, total, headers = self._look(mailbox)
                except (imaplib.IMAP4.error, OSError, ValueError, ssl.SSLError):
                    continue                       # leave the last good answer in place
                with self.lock:
                    self.values[(mailbox, "unread")] = unread
                    self.values[(mailbox, "total")] = total
                    for key in ("from", "subject", "date"):
                        if key in headers:
                            self.values[(mailbox, key)] = headers[key]
                    if "from" in headers or "subject" in headers:
                        self.values[(mailbox, "line")] = (
                            ("%s - " % headers["from"] if headers.get("from") else "")
                            + headers.get("subject", "")).strip(" -")
            time.sleep(IMAP_CACHE_SECONDS)


IMAP_MAILBOXES = {}


def imap_mailbox_for(name, entries):
    """The mailbox `<name>` means, from the same endpoints.json the others use."""
    if name in IMAP_MAILBOXES:
        return IMAP_MAILBOXES[name]
    entry = entries.get(name)
    if not isinstance(entry, dict):
        return None
    url = str(entry.get("url", ""))
    if not url.startswith(("imaps://", "imap://", "ssl://")):
        return None
    mailbox = ImapMailbox(name, url, str(entry.get("user", "")), str(entry.get("token", "")))
    IMAP_MAILBOXES[name] = mailbox
    return mailbox


def imap_value(spec, entries):
    """`imap:<endpoint>/<mailbox>#<field>` -> a count, or something about the newest message."""
    rest = spec[len("imap:"):]
    address, separator, field = rest.rpartition("#")
    if not separator:
        return ""
    endpoint, slash, mailbox = address.partition("/")
    if not slash:
        endpoint, mailbox = address, "INBOX"
    mailbox = mailbox or "INBOX"
    if field not in ("unread", "total", "from", "subject", "date", "line"):
        return ""
    mailbox_for = imap_mailbox_for(endpoint, entries)
    if mailbox_for is None:
        return ""
    mailbox_for.ask_for(mailbox, field)
    return mailbox_for.value(mailbox, field)


class Values:
    """The live numbers and strings an applet can put on the screen.

    Sources are named in the applet's JSON: a plain name (cpu, memory, time, ...), or
    file:<path>, cmd:<shell command> and env:<name> for anything else. Expensive ones are
    cached for a short while, because a visual redraws every second or so and shelling out
    that often for a clock would be silly.
    """

    CACHE_SECONDS = 2.0
    #: Live sources are read far more often: a game's HUD should not lag a quarter of a
    #: second behind the game because of a cache meant for clocks.
    LIVE_CACHE_SECONDS = 0.2

    def __init__(self, clock=time.monotonic, disabled=None):
        self.clock = clock
        self.cache = {}
        self.cpu_previous = None
        self.context = {}
        #: None means "ask the config file", which is cached: the sources panel runs in another
        #: process and its switch has to take effect without restarting the daemon.
        self._fixed_disabled = list(disabled) if disabled is not None else None
        self._disabled = []
        self._disabled_at = None
        #: Named endpoints, their stamp, and how often each address has failed (so an unreachable
        #: one is left alone for a while rather than stuttering the screen on every redraw).
        self._endpoints = {}
        self._endpoints_stamp = None
        self._http_failures = {}
        self._http_retry_at = {}

    def blocked_kinds(self):
        """The kinds of source this applet may not read, read from the config every few seconds."""
        if self._fixed_disabled is not None:
            return self._fixed_disabled
        now = self.clock()
        if self._disabled_at is None or now - self._disabled_at >= self.CACHE_SECONDS:
            self._disabled_at = now
            self._disabled = disabled_kinds()
        return self._disabled

    def set_context(self, **context):
        """State the driver told us about: recording, profile, recent presses."""
        self.context.update(context)

    def cpu_percent(self):
        with open("/proc/stat") as handle:
            fields = [int(value) for value in handle.readline().split()[1:]]
        idle = fields[3] + fields[4]
        total = sum(fields)
        if self.cpu_previous is None:
            self.cpu_previous = (idle, total)
            return 0.0
        idle_delta = idle - self.cpu_previous[0]
        total_delta = total - self.cpu_previous[1]
        self.cpu_previous = (idle, total)
        if total_delta <= 0:
            return 0.0
        return 100.0 * (total_delta - idle_delta) / total_delta

    def memory_percent(self):
        values = {}
        with open("/proc/meminfo") as handle:
            for line in handle:
                key, _, rest = line.partition(":")
                values[key] = int(rest.split()[0])
        total = values.get("MemTotal", 1)
        return 100.0 * (total - values.get("MemAvailable", 0)) / total

    def uptime_seconds(self):
        with open("/proc/uptime") as handle:
            return float(handle.read().split()[0])

    def media(self):
        line = shell("playerctl metadata --format '{{status}}|{{artist}}|{{title}}|"
                     "{{position}}|{{mpris:length}}'") if self.which("playerctl") else None
        parts = (line.split("|") + [""] * 5)[:5] if line else ["", "", "", "", ""]
        duration = 0
        try:
            duration = int(parts[4]) // 1_000_000
        except ValueError:
            pass
        return parts, duration

    @staticmethod
    def which(program):
        return any(os.access(os.path.join(path, program), os.X_OK)
                   for path in os.environ.get("PATH", "").split(os.pathsep))

    def raw(self, source):
        now = self.clock()
        cached = self.cache.get(source)
        # These three are already local and already cheap: a file or a dict lookup, not a command
        # or a fetch. `mqtt:` is here because its value is pushed to us and kept - caching it for
        # two seconds would make a pushed value appear late for no reason at all.
        seconds = (self.LIVE_CACHE_SECONDS if source.startswith(("json:", "file:", "mqtt:", "ws:"))
                   else self.CACHE_SECONDS)
        if cached and now - cached[0] < seconds:
            return cached[1]

        value = self.resolve(source)
        self.cache[source] = (now, value)
        return value

    def resolve(self, source):
        if source_kind(source) in self.blocked_kinds():
            # Switched off in the sources panel. Empty, like a file that is not there, so the
            # visual keeps drawing; the panel and `g13-applet check` are what say why.
            return ""
        now = datetime.now()
        uptime = self.uptime_seconds()
        media, duration = self.media()
        position = 0
        try:
            position = int(media[3]) // 1_000_000
        except ValueError:
            pass

        built_in = {
            "cpu": self.cpu_percent,
            "memory": self.memory_percent,
            "load": lambda: float(open("/proc/loadavg").read().split()[0]),
            "uptime": lambda: "%dh%02dm" % (int(uptime // 3600), int(uptime % 3600) // 60),
            "uptime_seconds": lambda: uptime,
            "time": lambda: now.strftime("%H:%M"),
            "time_seconds": lambda: now.strftime("%H:%M:%S"),
            "date": lambda: now.strftime("%d/%m/%Y"),
            "day": lambda: now.strftime("%a"),
            "media_status": lambda: media[0],
            "media_artist": lambda: media[1],
            "media_title": lambda: media[2],
            "media_position": lambda: "%d:%02d" % (position // 60, position % 60),
            "media_duration": lambda: "%d:%02d" % (duration // 60, duration % 60),
            "media_percent": lambda: (100.0 * position / duration) if duration else 0.0,
            "profile": lambda: "M%d" % (int(self.context.get("profile", 0)) + 1),
            "recording": lambda: "yes" if self.context.get("recording") else "no",
            "last_key": lambda: (self.context.get("recent") or ["-"])[-1],
            "recent_keys": lambda: " ".join(self.context.get("recent", [])),
            "screen_width": lambda: g13lcd.VISIBLE_WIDTH,
            "screen_height": lambda: g13lcd.VISIBLE_HEIGHT,
        }

        if source in built_in:
            return built_in[source]()

        if source.startswith("env:"):
            return os.environ.get(source[4:], "")

        if source.startswith("file:"):
            try:
                with open(os.path.expanduser(source[5:])) as handle:
                    return handle.readline().strip()
            except OSError:
                return ""

        if source.startswith("json:"):
            return self.json_field(source[5:])

        if source.startswith("cmd:"):
            return shell(source[4:]) or ""

        if source.startswith("http:"):
            return self.http_field(source)

        if source.startswith("regex:"):
            return self.regex_field(source[6:])

        if source.startswith("mqtt:"):
            return mqtt_value(source, self.endpoints())

        if source.startswith("ws:"):
            return ws_value(source, self.endpoints())

        if source.startswith("imap:"):
            return imap_value(source, self.endpoints())

        return ""

    def regex_field(self, spec):
        """A pattern out of a text file: `regex:<path>#<pattern>`, e.g. regex:/tmp/game.log#hp=(\\d+).

        For anything that can only *print* rather than write JSON - a game script, a log, a shell
        loop. The pattern is a Python regular expression and the value is the last match in the
        file, so a log that grows keeps giving the newest reading. Only the tail is read (a log can
        be enormous and the daemon redraws every second), the first `#` separates the path from the
        pattern, and with no capture group the whole match is the value. As everywhere else here: a
        missing file, an unreadable one, a bad pattern or no match at all read as empty, because a
        game that is not running must leave the screen blank rather than take anything down.
        """
        path, _, pattern = spec.partition("#")
        if not pattern:
            return ""
        try:
            with open(os.path.expanduser(path), "rb") as handle:
                handle.seek(0, os.SEEK_END)
                handle.seek(max(0, handle.tell() - REGEX_TAIL_BYTES))
                text = handle.read().decode("utf-8", "replace")
        except OSError:
            return ""
        try:
            matches = re.findall(pattern, text)
        except re.error:
            return ""
        if not matches:
            return ""
        last = matches[-1]
        if isinstance(last, tuple):
            last = last[0] if last else ""
        return last if isinstance(last, (str, int, float)) else ""

    def json_field(self, spec):
        """One field of a JSON file: `json:<path>#<field>`, e.g. json:/tmp/hud.json#ammo.

        This is how a game feeds the screen: it writes a small JSON file and the applet
        reads the fields it wants. Nested fields are dotted (`#hud.ammo`) and a list index
        is a number (`#route.0`). With no field the whole file is a value only if it is a
        single number, string or boolean. A missing file, unreadable JSON, missing field or
        wrong type all read as an empty string - a game that is not running must leave the
        screen blank, not take the daemon down.
        """
        path, separator, field = spec.rpartition("#")
        if not separator:
            path, field = spec, ""

        try:
            with open(os.path.expanduser(path)) as handle:
                data = json.load(handle)
        except (OSError, ValueError):
            return ""

        if not field:
            return data if isinstance(data, (int, float, str, bool)) else ""

        return field_of(data, field)

    def endpoints(self):
        """The named web addresses, re-read from endpoints.json when it changes.

        This is where an address and its credential live, so an applet that gets shared carries a
        name like `http:weather/now#temp` and no key at all.
        """
        path = config_dir() / ENDPOINTS_FILE
        try:
            stamp = path.stat().st_mtime
        except OSError:
            self._endpoints, self._endpoints_stamp = {}, None
            return self._endpoints
        if stamp != self._endpoints_stamp:
            try:
                data = json.loads(path.read_text())
            except (OSError, ValueError):
                data = {}
            self._endpoints = data if isinstance(data, dict) else {}
            self._endpoints_stamp = stamp
        return self._endpoints

    def http_field(self, spec):
        """One value from a web address: `http:<endpoint>/<path>#<field>`.

        Everything that can go wrong - no such endpoint, refused, timed out, an error status, a
        body that is not JSON, a field that is not there - reads as empty, exactly like a game that
        is not running. A name that is not in endpoints.json is empty too rather than an error: the
        applet says what it wanted, and `g13-applet check --values` is where a person finds out why.
        """
        now = self.clock()
        if now < self._http_retry_at.get(spec, 0):
            return ""

        endpoint, tail, field = split_http(spec)
        named = self.endpoints().get(endpoint)
        if isinstance(named, dict):
            base = str(named.get("url", ""))
            headers = dict(named.get("headers") or {})
            if named.get("token"):
                # The usual shape for a home server: a bearer token on every request.
                headers.setdefault("Authorization", "Bearer %s" % named["token"])
            timeout = float(named.get("timeout", HTTP_TIMEOUT))
            insecure = bool(named.get("insecure"))
        elif "://" in endpoint or endpoint.startswith("//") or "." in endpoint:
            base = endpoint if "://" in endpoint else "http:" + endpoint
            headers, timeout, insecure = {}, HTTP_TIMEOUT, False
        else:
            return self.http_gave_up(spec, now)

        url = base.rstrip("/") + ("/" + tail if tail else "")
        try:
            context = None
            if insecure:
                context = ssl.create_default_context()
                context.check_hostname = False
                context.verify_mode = ssl.CERT_NONE
            request = urllib.request.Request(url, headers=headers)
            with urllib.request.urlopen(request, timeout=timeout, context=context) as response:
                body = response.read(HTTP_LIMIT).decode("utf-8", "replace")
        except (OSError, ValueError, http.client.HTTPException):
            return self.http_gave_up(spec, now)

        self._http_failures.pop(spec, None)
        self._http_retry_at.pop(spec, None)

        if not field:
            return body.strip().splitlines()[0] if body.strip() else ""
        try:
            return field_of(json.loads(body), field)
        except ValueError:
            return ""

    def http_gave_up(self, spec, now):
        """Remembers that an address failed, and backs off so it cannot stutter the screen."""
        failures = self._http_failures.get(spec, 0) + 1
        self._http_failures[spec] = failures
        self._http_retry_at[spec] = now + min(60.0, 2.0 ** failures)
        return ""

    def all(self, sources):
        """Resolves several sources at once, for the values file."""
        return {source: self.raw(source) for source in sources}


class LayoutVisual:
    """A visual described by JSON rather than by code: the applet designer's output.

    Widgets are placed on the screen and bound to data::

        {"name": "stats", "title": "STATS", "interval": 1,
         "widgets": [
            {"type": "text", "x": 3, "y": 12, "format": "CPU {cpu:.0f}%"},
            {"type": "bar",  "x": 28, "y": 12, "w": 88, "h": 8, "source": "cpu", "max": 100},
            {"type": "line", "x": 1, "y": 30, "w": 158},
            {"type": "box",  "x": 1, "y": 18, "w": 158, "h": 10}]}

    `format` is a str.format template over every value (so one label can show several), and
    `source` is the single value a bar uses.
    """

    def __init__(self, definition, values):
        self.definition = definition
        self.values = values
        self.name = APPLET_PREFIX + str(definition.get("name", "applet"))
        self.interval = max(0.05, float(number_or(definition.get("interval"), 1.0)))
        #: Short names for data sources, so a widget can say {"source": "ammo"} and a
        #: format can say {ammo} instead of repeating a path in full:
        #: "sources": {"ammo": "json:~/hud.json#ammo"}
        self.aliases = {str(key): str(value) for key, value in
                        (definition.get("sources") or {}).items()}

    @property
    def title(self):
        return str(self.definition.get("title", self.definition.get("name", "APPLET")))

    def spec_of(self, name):
        """The real source an applet's short name stands for, following aliases."""
        for _step in range(8):
            if name not in self.aliases:
                break
            name = self.aliases[name]
        return name

    def asked_names(self):
        """The names the applet mentions: widget sources and format fields."""
        wanted = set()
        for widget in self.definition.get("widgets", []):
            if widget.get("source"):
                wanted.add(str(widget["source"]))
            for _literal, field, _spec, _conversion in string.Formatter().parse(
                    widget.get("format") or ""):
                if field:
                    wanted.add(field.split(".")[0].split("[")[0])
        return sorted(wanted)

    def sources(self):
        """Every data source this applet asks for, as the specs to actually read."""
        return sorted({self.spec_of(name) for name in self.asked_names()})

    def value_of(self, source):
        if source is None:
            return ""
        return self.values.raw(self.spec_of(str(source)))

    def follow_seconds(self):
        """How long this applet keeps the screen after its data stops arriving, or 0.

        A game HUD is written from outside, so the applet can say so:

            "follow": {"seconds": 20}

        `"follow": true` uses the default. Without it the applet is only ever shown because
        somebody chose it.
        """
        follow = self.definition.get("follow", 0)
        if follow is True:
            return FOLLOW_SECONDS
        if isinstance(follow, dict):
            try:
                return float(follow.get("seconds", FOLLOW_SECONDS))
            except (TypeError, ValueError):
                return FOLLOW_SECONDS
        try:
            return float(follow or 0)
        except (TypeError, ValueError):
            return 0.0

    def render(self, screen, context):
        border = self.definition.get("border", True)
        if border:
            screen.frame_and_title(self.title)
        values = self.values.all(self.sources())
        # The applet's own short names work in formats too, so {ammo} can stand for a path.
        for name in self.asked_names():
            spec = self.spec_of(name)
            if spec in values:
                values[name] = values[spec]

        for widget in self.definition.get("widgets", []):
            kind = widget.get("type", "text")
            x = self.geometry(widget, "x", 0)
            y = self.geometry(widget, "y", 0)

            if kind == "text":
                template = widget.get("format")
                if template is None:
                    message = str(self.value_of(widget.get("source")))
                else:
                    # A field with no value yet - the game is not running, the file has not
                    # been written - reads as blank. "?" is kept for a format that cannot be
                    # read at all, which is a mistake in the applet rather than missing data.
                    try:
                        message = template.format_map(_Blank(values))
                    except (ValueError, IndexError):
                        message = "?"

                # A long line - an objective, a track title - slides along rather than
                # being cut off at the edge.
                if widget.get("scroll"):
                    message = scrolling(message, widget)

                # Alignment is computed from the text, so a design can pin a value to the
                # right edge without knowing how wide the number will be.
                align = widget.get("align")
                margin = self.geometry(widget, "margin", 3)
                if align == "centre":
                    x = centred(message)
                elif align == "right":
                    x = max(0, g13lcd.VISIBLE_WIDTH - margin - len(message) * 6)
                screen.text(x, y, message)

            elif kind == "bar":
                top = self.number(widget, "max", 100) or 100
                try:
                    percent = 100.0 * float(self.value_of(widget.get("source"))) / top
                except (TypeError, ValueError):
                    percent = 0
                screen.bar(x, y, self.geometry(widget, "w", 88), self.geometry(widget, "h", 8),
                           percent)

            elif kind == "line":
                screen.rect(x, y, x + self.geometry(widget, "w", 158), y + 1)

            elif kind == "box":
                screen.rect(x, y, x + self.geometry(widget, "w", 158),
                            y + self.geometry(widget, "h", 10))

            elif kind == "segments":
                top = self.number(widget, "max", 100) or 100
                try:
                    percent = 100.0 * float(self.value_of(widget.get("source"))) / top
                except (TypeError, ValueError):
                    percent = 0
                screen.segments(x, y, self.geometry(widget, "w", 88), self.geometry(widget, "h", 6),
                                self.geometry(widget, "count", 12), percent)

            elif kind == "brackets":
                screen.brackets(x, y, self.geometry(widget, "w", 158),
                                self.geometry(widget, "h", 10), self.geometry(widget, "len", 6),
                                self.geometry(widget, "thick", 2))

            elif kind == "arrow":
                screen.arrow(x, y, self.number(widget, "r", 8), self.angle_of(widget))

            elif kind == "turn":
                screen.turn(x, y, self.angle_of(widget), self.geometry(widget, "size", 11))

            elif kind == "vline":
                screen.rect(x, y, x + 1, y + self.geometry(widget, "h", 10))

    def geometry(self, widget, name, default):
        """A whole number out of a hand-written widget, or the default.

        Applets are edited by hand, so a wrong type has to be an ordinary mistake rather than a
        crash: the draw loop runs inside the daemon, and one bad field would end the pad's screen
        until the file was fixed. `g13-applet check` is what tells the author.
        """
        return int(number_or(widget.get(name), default))

    def number(self, widget, name, default):
        """The same for a value that may be fractional."""
        return float(number_or(widget.get(name), default))

    def angle_of(self, widget):
        """The angle a directional widget points at, read from its source.

        A game that is not running gives no value, and no direction is the right answer
        then, so the arrow points up rather than the applet falling over.
        """
        try:
            return float(self.value_of(widget.get("source")))
        except (TypeError, ValueError):
            return 0.0


def applet_dir():
    return config_dir() / "applets"


def load_applets(values):
    """Every designed applet in the applets directory, newest content each call."""
    applets = {}
    directory = applet_dir()
    if not directory.is_dir():
        return applets

    for path in sorted(directory.glob("*.json")):
        try:
            definition = json.loads(path.read_text())
            if not isinstance(definition, dict):
                raise ValueError("the file is not a JSON object")
            definition.setdefault("name", path.stem)
            visual = LayoutVisual(definition, values)
        except Exception as error:  # a bad applet file must not take the daemon down
            print("skipping applet %s: %s: %s" % (path, type(error).__name__, error),
                  file=sys.stderr)
            continue
        applets[visual.name] = visual
    return applets


def registry(values):
    """The built-in visuals plus every designed applet."""
    visuals = {visual.name: visual for visual in VISUALS}
    visuals.update(load_applets(values))
    return visuals


class Engine:
    """Turns button presses into a screen.

    Kept free of sockets and timers so it can be driven directly in tests.
    """

    def __init__(self, config=None, clock=time.monotonic, visuals=None, values=None):
        self.clock = clock
        self.values = values
        self.visuals = visuals if visuals is not None else {item.name: item for item in VISUALS}
        self.config = config or {}
        available = list(self.visuals)
        self.enabled = [name for name in self.config.get("enabled", available)
                        if name in self.visuals] or available[:1]
        self.active = self.config.get("active", self.enabled[0])
        if self.active not in self.visuals:
            self.active = self.enabled[0]
        self.cycle = bool(self.config.get("cycle", False))
        self.cycle_seconds = float(self.config.get("cycle_seconds", 10))

        self.menu_open = False
        self.menu_index = 0
        self.recent = []
        self.recording = False
        self.profile = 0

        self.menu_button_pressed_at = None
        self.last_cycle_at = clock()

    # --- configuration ---

    def snapshot(self):
        """The part of the state that belongs in the config file."""
        return {
            "enabled": self.enabled,
            "active": self.active,
            "cycle": self.cycle,
            "cycle_seconds": self.cycle_seconds,
        }

    # --- what is on the menu ---

    def menu_items(self):
        items = [("cycle", "Auto-cycle: %s" % ("on" if self.cycle else "off"))]
        for name in self.enabled:
            title = getattr(self.visuals[name], "title", name)
            items.append((name, str(title)[:24]))
        return items

    def switch_to(self, name):
        if name in self.visuals:
            self.active = name
            self.last_cycle_at = self.clock()

    def next_visual(self):
        if self.active in self.enabled:
            index = self.enabled.index(self.active)
        else:
            index = -1
        self.switch_to(self.enabled[(index + 1) % len(self.enabled)])

    # --- events ---

    def on_key(self, code, pressed):
        """Handles one physical key change from the pad."""
        if pressed:
            self.recent.append(KEY_NAMES.get(code, "code %d" % code))
            self.recent = self.recent[-6:]

        if code == MENU_BUTTON:
            self.on_menu_button(pressed)
            return

        if not self.menu_open or not pressed:
            return

        if code == BUTTON_UP:
            self.menu_index = (self.menu_index - 1) % len(self.menu_items())
        elif code == BUTTON_DOWN:
            self.menu_index = (self.menu_index + 1) % len(self.menu_items())
        elif code == BUTTON_SELECT:
            self.select_menu_item()
        elif code == BUTTON_BACK:
            self.menu_open = False

    def on_menu_button(self, pressed):
        """G24: a tap moves on, holding it opens the menu."""
        now = self.clock()
        if pressed:
            self.menu_button_pressed_at = now
            return

        held_for = now - self.menu_button_pressed_at if self.menu_button_pressed_at else 0
        self.menu_button_pressed_at = None

        if held_for >= LONG_PRESS_SECONDS:
            self.menu_open = not self.menu_open
            self.menu_index = 0
        elif self.menu_open:
            self.menu_open = False
        else:
            self.next_visual()

    def select_menu_item(self):
        key, _label = self.menu_items()[self.menu_index]
        if key == "cycle":
            self.cycle = not self.cycle
        else:
            self.switch_to(key)
            self.menu_open = False
        self.menu_index = 0

    def on_state(self, what, value):
        """State the driver broadcasts, e.g. recording starting."""
        if what == "recording":
            self.recording = bool(value)
        elif what == "profile":
            self.profile = int(value)

    # --- output ---

    def tick(self):
        """Returns the lines to draw, or None when nothing needs redrawing."""
        now = self.clock()
        if self.cycle and not self.menu_open and now - self.last_cycle_at >= self.cycle_seconds:
            self.next_visual()

        screen = Screen()
        context = {
            "recording": self.recording,
            "profile": self.profile,
            "recent": self.recent,
        }
        if self.values is not None:
            self.values.set_context(**context)

        if self.menu_open:
            self.render_menu(screen)
        else:
            self.visuals[self.active].render(screen, context)
        return screen.lines()

    def render_menu(self, screen):
        """A vertical menu, four rows at a time, scrolling with the selection."""
        items = self.menu_items()
        per_page = 4

        screen.rect(0, 0, g13lcd.VISIBLE_WIDTH, 1)
        screen.text(3, 1, "VISUALS")

        # Keep the selection on screen when there are more items than fit.
        first = 0
        if len(items) > per_page:
            first = max(0, min(self.menu_index - per_page // 2, len(items) - per_page))

        for row, (_key, label) in enumerate(items[first:first + per_page]):
            index = first + row
            y = 11 + row * 8
            if index == self.menu_index:
                # The screen has one colour of ink, so a selection cannot be a filled
                # row with text on it - the text would disappear into it. A marker bar
                # beside the label and a line underneath say the same thing and leave
                # the pixels the text needs blank.
                screen.rect(2, y, 5, y + 7)
                screen.rect(8, y + 7, g13lcd.VISIBLE_WIDTH - 3, y + 8)
            screen.text(9, y, label[:24])

    def interval(self):
        """How long until this visual needs redrawing."""
        return 1.0 if self.menu_open else self.visuals[self.active].interval


def read_config():
