    "cpu", "memory", "load", "uptime", "uptime_seconds", "time", "time_seconds", "date",
    "day", "media_status", "media_artist", "media_title", "media_position",
    "media_duration", "media_percent", "profile", "recording", "last_key", "recent_keys",
    "screen_width", "screen_height",
]


def publish(lines, values):
    """Publishes what is on the screen, and the live values, for the config tool.

    The tool cannot read the panel, so this is how its preview shows the real thing and
    how the applet designer previews a design against live data.
    """
    runtime = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
    try:
        with open(os.path.join(runtime, "g13-screen"), "w") as handle:
            handle.write("\n".join(lines) + "\n")
        with open(os.path.join(runtime, "g13-values.json"), "w") as handle:
            json.dump(values, handle, indent=2, sort_keys=True)
    except OSError:
        pass


def main():
    values = Values()
    visuals = registry(values)
    engine = Engine(read_config(), visuals=visuals, values=values)

    config_stamp = None
    last_poll = 0.0
    last_drawn = 0.0
    dirty = True
    shown_state = None

    while True:
        # --- the driver's event socket, reconnecting as needed ---
        try:
            connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            connection.settimeout(0.2)
            connection.connect(str(socket_path()))
        except OSError:
            time.sleep(RECONNECT_SECONDS)
            last_poll = 0.0
            continue

        print("g13-visuals: connected to %s, showing '%s'" % (socket_path(), engine.active), flush=True)
        pending = b""

        while True:
            try:
                chunk = connection.recv(4096)
            except socket.timeout:
                chunk = None
            except OSError:
                chunk = b""

            if chunk == b"":
                break  # Driver went away; reconnect.

            if chunk:
                pending += chunk
                while b"\n" in pending:
                    line, pending = pending.split(b"\n", 1)
                    fields = line.decode(errors="replace").split()
                    if len(fields) >= 3 and fields[0] == "key":
                        engine.on_key(int(fields[1]), fields[2] != "0")
                        dirty = True
                    elif len(fields) >= 3 and fields[0] == "state":
                        engine.on_state(fields[1], fields[2])
                        dirty = True

            now = time.monotonic()

            # --- pick up applets and config changes made elsewhere (the config tool) ---
            if now - last_poll >= CONFIG_POLL_SECONDS:
                last_poll = now
                path = config_dir() / "visuals.json"
                try:
                    stamp = path.stat().st_mtime
                except OSError:
                    stamp = None

                if stamp != config_stamp:
                    config_stamp = stamp
                    fresh_visuals = registry(values)
                    fresh = Engine(read_config(), clock=engine.clock,
                                   visuals=fresh_visuals, values=values)
                    # Keep the current visual if it still exists, so editing an applet
                    # does not bounce the screen back to the first one.
                    if engine.active in fresh.visuals and engine.active != fresh.active:
                        fresh.active = engine.active
                        fresh.enabled = [name for name in fresh.enabled] or [engine.active]
                        if engine.active not in fresh.enabled:
                            fresh.enabled.append(engine.active)
                    if fresh.snapshot() != engine.snapshot() or set(fresh.visuals) != set(engine.visuals):
                        engine = fresh
                        dirty = True

            # --- draw when the visual asks for it, or straight after a button ---
            if dirty or now - last_drawn >= engine.interval():
                lines = engine.tick()
                g13lcd.send(lines)

                sources = list(PUBLISHED_SOURCES)
                active = engine.visuals.get(engine.active)
                if isinstance(active, LayoutVisual):
                    sources += [source for source in active.sources()
                                if not source.startswith("cmd:")]
                publish(lines, values.all(sources))

                last_drawn = now
                if shown_state != engine.snapshot():
                    shown_state = engine.snapshot()
                    write_config(shown_state)
                dirty = False


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
