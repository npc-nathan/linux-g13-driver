#!/usr/bin/env python3
"""g13-visuals - the G13's screen: a set of visuals and a menu to choose between them.

The screen is 160x43 pixels of one colour, so each visual lays itself out with a border,
a title and content, using the drawing helpers in g13lcd.

Buttons, all on the device:

    G24 (round button left of the screen)   short press: next visual
                                            long press:  open the menu
    L1                                      back (closes the menu)
    L2 / L3                                 up / down
    L4                                      select

The menu is vertical: the selection is the row with a box drawn around it.

Configuration lives in $XDG_CONFIG_HOME/g13/visuals.json - which visuals are enabled, the
order, which one is showing, and whether they cycle on a timer. The config tool edits that
file; this daemon picks the change up within a second, so nothing here needs to be
restarted.

Visuals:
    clock    time and date
    system   cpu, memory, load, uptime
    media    whatever playerctl reports
    pad      active profile and the last few button presses
    custom   five lines from $XDG_CONFIG_HOME/g13/screen.txt
"""
import json
import os
import socket
import string
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import g13lcd

# --- device buttons ---
MENU_BUTTON = 24        # G24, the round button left of the screen
BUTTON_BACK = 25        # L1
BUTTON_UP = 26          # L2
BUTTON_DOWN = 27        # L3
BUTTON_SELECT = 28      # L4

LONG_PRESS_SECONDS = 0.6
CONFIG_POLL_SECONDS = 1.0
RECONNECT_SECONDS = 2.0

KEY_NAMES = {index: "G%d" % index for index in range(22)}
KEY_NAMES.update({
    24: "G24", 25: "L1", 26: "L2", 27: "L3", 28: "L4",
    29: "M1", 30: "M2", 31: "M3", 32: "MR",
    33: "THUMB-L", 34: "THUMB-D", 35: "THUMB-T",
    36: "STICK-UP", 37: "STICK-DOWN", 38: "STICK-LEFT", 39: "STICK-RIGHT",
    41: "LIGHT",
})


def config_dir():
    """The driver's config directory, honouring XDG_CONFIG_HOME."""
    base = os.environ.get("XDG_CONFIG_HOME")
    if base:
        return Path(base) / "g13"
    return Path(os.path.expanduser("~")) / ".config" / "g13"


def socket_path():
    """The driver's event socket."""
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if runtime:
        return Path(runtime) / "g13.sock"
    return Path("/tmp") / "g13.sock"


class Screen:
    """One 160x43 screen: pixels plus text drawn on top of them.

    Text cannot be drawn over filled pixels - the screen has one colour of ink - so the
    layout keeps text on blank areas and this class is just a description of what goes
    where. It becomes the driver's line protocol with lines().
    """

    def __init__(self):
        self.rows = g13lcd.blank()
        self.texts = []

    def text(self, x, y, message):
        self.texts.append((int(x), int(y), str(message)))

    def rect(self, x0, y0, x1, y1, value=1):
        g13lcd.draw_rect(self.rows, x0, y0, x1, y1, value)

    def bar(self, x, y, width, height, percent):
        g13lcd.draw_bar(self.rows, x, y, width, height, percent)

    def frame_and_title(self, title):
        """The house style: a border, a title, and a rule under it."""
        width, height = g13lcd.VISIBLE_WIDTH, g13lcd.VISIBLE_HEIGHT
        self.rect(0, 0, width, 1)
        self.rect(0, height - 1, width, height)
        self.rect(0, 0, 1, height)
        self.rect(width - 1, 0, width, height)
        self.rect(1, 9, width - 1, 10)
        self.text(3, 2, title)

    def lines(self):
        lines = ["#bitmap " + g13lcd.pixels_to_frame(self.rows).hex()]
        for x, y, message in self.texts:
            lines.append("#text %d %d %s" % (x, y, message))
        return lines


def centred(message, width=None):
    """Left padding that centres a string on the screen."""
    width = width or g13lcd.VISIBLE_WIDTH
    return max(0, (width - len(message) * 6) // 2)


class ClockVisual:
    name = "clock"
    title = "CLOCK"
    interval = 1.0

    def render(self, screen, context):
        now = datetime.now()
        screen.frame_and_title(self.title)
        screen.text(centred(now.strftime("%H:%M:%S")), 17, now.strftime("%H:%M:%S"))
        screen.text(centred(now.strftime("%a %d %b %Y")), 29, now.strftime("%a %d %b %Y"))


class SystemVisual:
    name = "system"
    title = "SYSTEM"
    interval = 2.0

    def __init__(self):
        self.previous = None

    def cpu_percent(self):
        """Busy share of the cpu since the last look."""
        with open("/proc/stat") as handle:
            fields = [int(value) for value in handle.readline().split()[1:]]
        idle = fields[3] + fields[4]
        total = sum(fields)

        if self.previous is None:
            self.previous = (idle, total)
            return 0

        idle_delta = idle - self.previous[0]
        total_delta = total - self.previous[1]
        self.previous = (idle, total)
        if total_delta <= 0:
            return 0
        return int(100 * (total_delta - idle_delta) / total_delta)

    def memory_percent(self):
        values = {}
        with open("/proc/meminfo") as handle:
            for line in handle:
                key, _, rest = line.partition(":")
                values[key] = int(rest.split()[0])
        total = values.get("MemTotal", 1)
        available = values.get("MemAvailable", 0)
        return int(100 * (total - available) / total)

    def render(self, screen, context):
        usage = self.cpu_percent()
        memory = self.memory_percent()
        with open("/proc/loadavg") as handle:
            load = float(handle.read().split()[0])
        with open("/proc/uptime") as handle:
            uptime = float(handle.read().split()[0])

        screen.frame_and_title(self.title)
        for row, (label, percent) in enumerate((("CPU", usage), ("MEM", memory))):
            y = 12 + row * 10
            screen.text(3, y, label)
            screen.bar(28, y, 88, 8, percent)
            screen.text(122, y, "%3d%%" % percent)

        hours = int(uptime // 3600)
        screen.text(3, 33, "LOAD %.2f   UP %dh%02dm" % (load, hours, int(uptime % 3600) // 60))


class MediaVisual:
    name = "media"
    title = "MEDIA"
    interval = 1.0

    def metadata(self):
        """What the running media player reports, or None."""
        try:
            result = subprocess.run(
                ["playerctl", "metadata", "--format",
                 "{{status}}|{{artist}}|{{title}}|{{position}}|{{mpris:length}}"],
                capture_output=True, text=True, timeout=0.5)
        except (OSError, subprocess.SubprocessError):
            return None

        if result.returncode != 0 or not result.stdout.strip():
            return None
        parts = (result.stdout.strip().split("|") + [""] * 5)[:5]
        return parts

    def render(self, screen, context):
        screen.frame_and_title(self.title)
        data = self.metadata()

        if data is None:
            screen.text(centred("no player"), 18, "no player")
            return

        status, artist, title, position, length = data
        playing = "playing" if status == "Playing" else status.lower() or "stopped"
        screen.text(3, 12, (title or "unknown")[:24])
        screen.text(3, 21, (artist or "")[:24])

        try:
            done = int(position) // 1_000_000
            total = int(length) // 1_000_000
        except (TypeError, ValueError):
            done, total = 0, 0

        percent = int(100 * done / total) if total else 0
        screen.bar(3, 32, 110, 8, percent)
        screen.text(118, 32, ("%d:%02d" % (done // 60, done % 60)) if total else playing)


class PadVisual:
    name = "pad"
    title = "PAD"
    interval = 1.0

    def render(self, screen, context):
        screen.frame_and_title(self.title)
        profile = context.get("profile", 0)
        screen.text(3, 12, "PROFILE M%d" % (profile + 1))

        recording = "RECORDING" if context.get("recording") else "idle"
        screen.text(3, 21, "MR: %s" % recording)

        recent = context.get("recent", [])
        screen.text(3, 31, " ".join(recent[-6:]) or "-")


class CustomVisual:
    name = "custom"
    title = "CUSTOM"
    interval = 1.0

    def render(self, screen, context):
        screen.frame_and_title(self.title)
        path = config_dir() / "screen.txt"
        try:
            lines = path.read_text().splitlines()
        except OSError:
            lines = []

        if not lines:
            screen.text(3, 18, "put text in")
            screen.text(3, 28, "screen.txt")
            return

        for index, line in enumerate(lines[:4]):
            screen.text(3, 12 + index * 8, line)

    def lines(self):
        # The visual's own name for the menu.
        return self.name


VISUALS = [ClockVisual(), SystemVisual(), MediaVisual(), PadVisual(), CustomVisual()]
VISUALS_BY_NAME = {visual.name: visual for visual in VISUALS}

APPLET_PREFIX = "applet:"

# --- data a designed applet can show ---


def shell(command, timeout=0.4):
    """Runs a command for its output, or None if it fails or takes too long."""
    try:
        result = subprocess.run(command, shell=True, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.SubprocessError):
        return None
    if result.returncode != 0:
        return None
    return result.stdout.strip()


class Values:
    """The live numbers and strings an applet can put on the screen.

    Sources are named in the applet's JSON: a plain name (cpu, memory, time, ...), or
    file:<path>, cmd:<shell command> and env:<name> for anything else. Expensive ones are
    cached for a short while, because a visual redraws every second or so and shelling out
    that often for a clock would be silly.
    """

    CACHE_SECONDS = 2.0

    def __init__(self, clock=time.monotonic):
        self.clock = clock
        self.cache = {}
        self.cpu_previous = None
        self.context = {}

    def set_context(self, **context):
        """State the driver told us about: recording, profile, recent presses."""
        self.context.update(context)

    def cpu_percent(self):
        with open("/proc/stat") as handle:
            fields = [int(value) for value in handle.readline().split()[1:]]
        idle = fields[3] + fields[4]
        total = sum(fields)
        if self.cpu_previous is None:
            self.cpu_previous = (idle, total)
            return 0.0
        idle_delta = idle - self.cpu_previous[0]
        total_delta = total - self.cpu_previous[1]
        self.cpu_previous = (idle, total)
        if total_delta <= 0:
            return 0.0
        return 100.0 * (total_delta - idle_delta) / total_delta

    def memory_percent(self):
        values = {}
        with open("/proc/meminfo") as handle:
            for line in handle:
                key, _, rest = line.partition(":")
                values[key] = int(rest.split()[0])
        total = values.get("MemTotal", 1)
        return 100.0 * (total - values.get("MemAvailable", 0)) / total

    def uptime_seconds(self):
        with open("/proc/uptime") as handle:
            return float(handle.read().split()[0])

    def media(self):
        line = shell("playerctl metadata --format '{{status}}|{{artist}}|{{title}}|"
                     "{{position}}|{{mpris:length}}'") if self.which("playerctl") else None
        parts = (line.split("|") + [""] * 5)[:5] if line else ["", "", "", "", ""]
        duration = 0
        try:
            duration = int(parts[4]) // 1_000_000
        except ValueError:
            pass
        return parts, duration

    @staticmethod
    def which(program):
        return any(os.access(os.path.join(path, program), os.X_OK)
                   for path in os.environ.get("PATH", "").split(os.pathsep))

    def raw(self, source):
        now = self.clock()
        cached = self.cache.get(source)
        if cached and now - cached[0] < self.CACHE_SECONDS:
            return cached[1]

        value = self.resolve(source)
        self.cache[source] = (now, value)
        return value

    def resolve(self, source):
        now = datetime.now()
        uptime = self.uptime_seconds()
        media, duration = self.media()
        position = 0
        try:
            position = int(media[3]) // 1_000_000
        except ValueError:
            pass

        built_in = {
            "cpu": self.cpu_percent,
            "memory": self.memory_percent,
            "load": lambda: float(open("/proc/loadavg").read().split()[0]),
            "uptime": lambda: "%dh%02dm" % (int(uptime // 3600), int(uptime % 3600) // 60),
            "uptime_seconds": lambda: uptime,
            "time": lambda: now.strftime("%H:%M"),
            "time_seconds": lambda: now.strftime("%H:%M:%S"),
            "date": lambda: now.strftime("%d/%m/%Y"),
            "day": lambda: now.strftime("%a"),
            "media_status": lambda: media[0],
            "media_artist": lambda: media[1],
            "media_title": lambda: media[2],
            "media_position": lambda: "%d:%02d" % (position // 60, position % 60),
            "media_duration": lambda: "%d:%02d" % (duration // 60, duration % 60),
            "media_percent": lambda: (100.0 * position / duration) if duration else 0.0,
            "profile": lambda: "M%d" % (int(self.context.get("profile", 0)) + 1),
            "recording": lambda: "yes" if self.context.get("recording") else "no",
            "last_key": lambda: (self.context.get("recent") or ["-"])[-1],
            "recent_keys": lambda: " ".join(self.context.get("recent", [])),
            "screen_width": lambda: g13lcd.VISIBLE_WIDTH,
            "screen_height": lambda: g13lcd.VISIBLE_HEIGHT,
        }

        if source in built_in:
            return built_in[source]()

        if source.startswith("env:"):
            return os.environ.get(source[4:], "")

        if source.startswith("file:"):
            try:
                with open(os.path.expanduser(source[5:])) as handle:
                    return handle.readline().strip()
            except OSError:
                return ""

        if source.startswith("cmd:"):
            return shell(source[4:]) or ""

        return ""

    def all(self, sources):
        """Resolves several sources at once, for the values file."""
        return {source: self.raw(source) for source in sources}


class LayoutVisual:
    """A visual described by JSON rather than by code: the applet designer's output.

    Widgets are placed on the screen and bound to data::

        {"name": "stats", "title": "STATS", "interval": 1,
         "widgets": [
            {"type": "text", "x": 3, "y": 12, "format": "CPU {cpu:.0f}%"},
            {"type": "bar",  "x": 28, "y": 12, "w": 88, "h": 8, "source": "cpu", "max": 100},
            {"type": "line", "x": 1, "y": 30, "w": 158},
            {"type": "box",  "x": 1, "y": 18, "w": 158, "h": 10}]}

    `format` is a str.format template over every value (so one label can show several), and
    `source` is the single value a bar uses.
    """

    def __init__(self, definition, values):
        self.definition = definition
        self.values = values
        self.name = APPLET_PREFIX + str(definition.get("name", "applet"))
        self.interval = float(definition.get("interval", 1.0))

    @property
    def title(self):
        return str(self.definition.get("title", self.definition.get("name", "APPLET")))

    def sources(self):
        """Every data source this applet asks for."""
        wanted = set()
        for widget in self.definition.get("widgets", []):
            if widget.get("source"):
                wanted.add(widget["source"])
            for _literal, field, _spec, _conversion in string.Formatter().parse(
                    widget.get("format") or ""):
                if field:
                    wanted.add(field.split(".")[0].split("[")[0])
        return sorted(wanted)

    def value_of(self, source):
        if source is None:
            return ""
        return self.values.raw(source)

    def render(self, screen, context):
        border = self.definition.get("border", True)
        if border:
            screen.frame_and_title(self.title)
        values = self.values.all(self.sources())

        for widget in self.definition.get("widgets", []):
            kind = widget.get("type", "text")
            x = int(widget.get("x", 0))
            y = int(widget.get("y", 0))

            if kind == "text":
                template = widget.get("format")
                if template is None:
                    message = str(self.value_of(widget.get("source")))
                else:
                    try:
                        message = template.format(**values)
                    except (KeyError, ValueError, IndexError):
                        message = "?"

                # Alignment is computed from the text, so a design can pin a value to the
                # right edge without knowing how wide the number will be.
                align = widget.get("align")
                margin = int(widget.get("margin", 3))
                if align == "centre":
                    x = centred(message)
                elif align == "right":
                    x = max(0, g13lcd.VISIBLE_WIDTH - margin - len(message) * 6)
                screen.text(x, y, message)

            elif kind == "bar":
                top = float(widget.get("max", 100)) or 100
                try:
                    percent = 100.0 * float(self.value_of(widget.get("source"))) / top
                except (TypeError, ValueError):
                    percent = 0
                screen.bar(x, y, int(widget.get("w", 88)), int(widget.get("h", 8)), percent)

            elif kind == "line":
                screen.rect(x, y, x + int(widget.get("w", 158)), y + 1)

            elif kind == "box":
                screen.rect(x, y, x + int(widget.get("w", 158)), y + int(widget.get("h", 10)))

            elif kind == "vline":
                screen.rect(x, y, x + 1, y + int(widget.get("h", 10)))


def applet_dir():
    return config_dir() / "applets"


def load_applets(values):
    """Every designed applet in the applets directory, newest content each call."""
    applets = {}
    directory = applet_dir()
    if not directory.is_dir():
        return applets

    for path in sorted(directory.glob("*.json")):
        try:
            definition = json.loads(path.read_text())
        except (OSError, ValueError) as error:
            print("skipping %s: %s" % (path, error), file=sys.stderr)
            continue
        definition.setdefault("name", path.stem)
        visual = LayoutVisual(definition, values)
        applets[visual.name] = visual
    return applets


def registry(values):
    """The built-in visuals plus every designed applet."""
    visuals = {visual.name: visual for visual in VISUALS}
    visuals.update(load_applets(values))
    return visuals


class Engine:
    """Turns button presses into a screen.

    Kept free of sockets and timers so it can be driven directly in tests.
    """

    def __init__(self, config=None, clock=time.monotonic, visuals=None, values=None):
        self.clock = clock
        self.values = values
        self.visuals = visuals if visuals is not None else {item.name: item for item in VISUALS}
        self.config = config or {}
        available = list(self.visuals)
        self.enabled = [name for name in self.config.get("enabled", available)
                        if name in self.visuals] or available[:1]
        self.active = self.config.get("active", self.enabled[0])
        if self.active not in self.visuals:
            self.active = self.enabled[0]
        self.cycle = bool(self.config.get("cycle", False))
        self.cycle_seconds = float(self.config.get("cycle_seconds", 10))

        self.menu_open = False
        self.menu_index = 0
        self.recent = []
        self.recording = False
        self.profile = 0

        self.menu_button_pressed_at = None
        self.last_cycle_at = clock()

    # --- configuration ---

    def snapshot(self):
        """The part of the state that belongs in the config file."""
        return {
            "enabled": self.enabled,
            "active": self.active,
            "cycle": self.cycle,
            "cycle_seconds": self.cycle_seconds,
        }

    # --- what is on the menu ---

    def menu_items(self):
        items = [("cycle", "Auto-cycle: %s" % ("on" if self.cycle else "off"))]
        for name in self.enabled:
            title = getattr(self.visuals[name], "title", name)
            items.append((name, str(title)[:24]))
        return items

    def switch_to(self, name):
        if name in self.visuals:
            self.active = name
            self.last_cycle_at = self.clock()

    def next_visual(self):
        if self.active in self.enabled:
            index = self.enabled.index(self.active)
        else:
            index = -1
        self.switch_to(self.enabled[(index + 1) % len(self.enabled)])

    # --- events ---

    def on_key(self, code, pressed):
        """Handles one physical key change from the pad."""
        if pressed:
            self.recent.append(KEY_NAMES.get(code, "code %d" % code))
            self.recent = self.recent[-6:]

        if code == MENU_BUTTON:
            self.on_menu_button(pressed)
            return

        if not self.menu_open or not pressed:
            return

        if code == BUTTON_UP:
            self.menu_index = (self.menu_index - 1) % len(self.menu_items())
        elif code == BUTTON_DOWN:
            self.menu_index = (self.menu_index + 1) % len(self.menu_items())
        elif code == BUTTON_SELECT:
            self.select_menu_item()
        elif code == BUTTON_BACK:
            self.menu_open = False

    def on_menu_button(self, pressed):
        """G24: a tap moves on, holding it opens the menu."""
        now = self.clock()
        if pressed:
            self.menu_button_pressed_at = now
            return

        held_for = now - self.menu_button_pressed_at if self.menu_button_pressed_at else 0
        self.menu_button_pressed_at = None

        if held_for >= LONG_PRESS_SECONDS:
            self.menu_open = not self.menu_open
            self.menu_index = 0
        elif self.menu_open:
            self.menu_open = False
        else:
            self.next_visual()

    def select_menu_item(self):
        key, _label = self.menu_items()[self.menu_index]
        if key == "cycle":
            self.cycle = not self.cycle
        else:
            self.switch_to(key)
            self.menu_open = False
        self.menu_index = 0

    def on_state(self, what, value):
        """State the driver broadcasts, e.g. recording starting."""
        if what == "recording":
            self.recording = bool(value)
        elif what == "profile":
            self.profile = int(value)

    # --- output ---

    def tick(self):
        """Returns the lines to draw, or None when nothing needs redrawing."""
        now = self.clock()
        if self.cycle and not self.menu_open and now - self.last_cycle_at >= self.cycle_seconds:
            self.next_visual()

        screen = Screen()
        context = {
            "recording": self.recording,
            "profile": self.profile,
            "recent": self.recent,
        }
        if self.values is not None:
            self.values.set_context(**context)

        if self.menu_open:
            self.render_menu(screen)
        else:
            self.visuals[self.active].render(screen, context)
        return screen.lines()

    def render_menu(self, screen):
        """A vertical menu, four rows at a time, scrolling with the selection."""
        items = self.menu_items()
        per_page = 4

        screen.rect(0, 0, g13lcd.VISIBLE_WIDTH, 1)
        screen.text(3, 1, "VISUALS")

        # Keep the selection on screen when there are more items than fit.
        first = 0
        if len(items) > per_page:
            first = max(0, min(self.menu_index - per_page // 2, len(items) - per_page))

        for row, (_key, label) in enumerate(items[first:first + per_page]):
            index = first + row
            y = 11 + row * 8
            if index == self.menu_index:
                # The screen has one colour of ink, so a selection cannot be a filled
                # row with text on it - the text would disappear into it. A marker bar
                # beside the label and a line underneath say the same thing and leave
                # the pixels the text needs blank.
                screen.rect(2, y, 5, y + 7)
                screen.rect(8, y + 7, g13lcd.VISIBLE_WIDTH - 3, y + 8)
            screen.text(9, y, label[:24])

    def interval(self):
        """How long until this visual needs redrawing."""
        return 1.0 if self.menu_open else self.visuals[self.active].interval


def read_config():
    path = config_dir() / "visuals.json"
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return {}


def write_config(snapshot):
    path = config_dir() / "visuals.json"
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps(snapshot, indent=2) + "\n")
    except OSError as error:
        print("could not save %s: %s" % (path, error), file=sys.stderr)


