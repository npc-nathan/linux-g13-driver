def source_kind(spec):
    """Which kind of source a spec is: its prefix, or 'built-in' when it has none."""
    return spec.split(":", 1)[0] if ":" in spec else "built-in"


def disabled_kinds():
    """The kinds of source applets may not use. Nothing is off until it is switched off."""
    try:
        data = json.loads((config_dir() / SOURCES_FILE).read_text())
        listed = data.get("disabled") or []
    except (OSError, ValueError, AttributeError):
        return []
    return [kind for kind in listed if kind in [name for name, _why in SOURCE_KINDS]]


def set_kind_enabled(kind, on):
    """Switches a kind of source on or off for every applet. Returns the disabled list."""
    if kind not in [name for name, _why in SOURCE_KINDS]:
        raise ValueError("no such kind of source: %r" % kind)
    disabled = [item for item in disabled_kinds() if item != kind]
    if not on:
        disabled.append(kind)
    path = config_dir() / SOURCES_FILE
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps({"disabled": sorted(disabled)}, indent=2) + "\n")
    return sorted(disabled)

