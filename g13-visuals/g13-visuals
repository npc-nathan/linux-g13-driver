def config_dir():
    """The driver's config directory, honouring XDG_CONFIG_HOME."""
    base = os.environ.get("XDG_CONFIG_HOME")
    if base:
        return Path(base) / "g13"
    return Path(os.path.expanduser("~")) / ".config" / "g13"


def socket_path():
    """The driver's event socket."""
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if runtime:
        return Path(runtime) / "g13.sock"
    return Path("/tmp") / "g13.sock"


class Screen:
    """One 160x43 screen: pixels plus text drawn on top of them.

    Text cannot be drawn over filled pixels - the screen has one colour of ink - so the
    layout keeps text on blank areas and this class is just a description of what goes
    where. It becomes the driver's line protocol with lines().
    """

    def __init__(self):
        self.rows = g13lcd.blank()
        self.texts = []

    def text(self, x, y, message):
        self.texts.append((int(x), int(y), str(message)))

    def rect(self, x0, y0, x1, y1, value=1):
        g13lcd.draw_rect(self.rows, x0, y0, x1, y1, value)

    def bar(self, x, y, width, height, percent):
        g13lcd.draw_bar(self.rows, x, y, width, height, percent)

    def segments(self, x, y, width, height, count, percent, gap=1):
        """A gauge made of blocks rather than a solid bar.

        Easier to read at a glance when it is small, and it gives the screen its own look
        instead of a progress bar borrowed from a desktop. Blocks are lit from the left in
        proportion to the percentage; nothing is drawn for the unlit ones, so there is no
        hollow track for a value to sit on.
        """
        count = max(1, int(count))
        width, height = int(width), int(height)
        block = (width - (count - 1) * gap) // count
        if block < 1:
            block, count = 1, max(1, width)
        lit = int(round(count * max(0.0, min(100.0, float(percent))) / 100.0))
        for index in range(min(count, lit)):
            left = int(x) + index * (block + gap)
            self.rect(left, y, left + block, y + height)

    def brackets(self, x, y, width, height, length=6, thick=2):
        """Corner marks only: a frame round a widget without boxing it in."""
        x, y = int(x), int(y)
        right, bottom = x + int(width), y + int(height)
        left_arm, down_arm = min(length, width // 2), min(length, height // 2)

        self.rect(x, y, x + left_arm, y + thick)
        self.rect(x, y, x + thick, y + down_arm)
        self.rect(right - left_arm, y, right, y + thick)
        self.rect(right - thick, y, right, y + down_arm)
        self.rect(x, bottom - thick, x + left_arm, bottom)
        self.rect(x, bottom - down_arm, x + thick, bottom)
        self.rect(right - left_arm, bottom - thick, right, bottom)
        self.rect(right - thick, bottom - down_arm, right, bottom)

    def arrow(self, cx, cy, radius, angle_degrees, tail=0):
        """A filled arrow: 0 points up, 90 right, and so on clockwise.

        A bearing is the one thing a screen this size cannot say in words, so a HUD points
        at the next corner instead of describing it.
        """
        radius = max(2.0, float(radius))
        angle = math.radians(float(angle_degrees))
        sin, cos = math.sin(angle), math.cos(angle)

        def placed(px, py):
            return (cx + px * cos - py * sin, cy + px * sin + py * cos)

        if tail:
            self.line(placed(0, 0.7 * radius), placed(0, 0.7 * radius + float(tail)), 2)

        self.fill_triangle([placed(0, -radius),
                            placed(-0.62 * radius, 0.62 * radius),
                            placed(0.62 * radius, 0.62 * radius)])

        # The apex is a single point, so the rasterised triangle loses it when the arrow is
        # not on an axis (the tip stops a pixel short). Stamp the point itself.
        tip_x, tip_y = placed(0, -radius)
        tip_x, tip_y = int(round(tip_x)) - 1, int(round(tip_y)) - 1
        self.rect(tip_x, tip_y, tip_x + 2, tip_y + 2)

    def turn(self, x, y, angle_degrees, size=11):
        """A turn arrow: which way the next corner goes.

        Four shapes rather than a rotated arrow - at this size twenty degrees is one pixel,
        and a road-sign shape reads at a glance where a slight rotation does not.
        """
        x, y = int(x), int(y)
        size = int(size)
        angle = float(angle_degrees)
        magnitude = abs(angle)
        middle = x + size // 2

        if magnitude <= 20:                       # straight on
            self.rect(middle, y + 3, middle + 2, y + size)
            self.arrow(middle + 1, y + 4, 3.2, 0)

        elif magnitude <= 115:                    # left or right
            if angle > 0:                         # right: along the bottom, up the right
                self.rect(x, y + size - 3, x + size - 5, y + size - 1)
                self.rect(x + size - 5, y + 3, x + size - 3, y + size)
                self.arrow(x + size - 4, y + 4, 3.2, 0)
            else:                                 # left: along the bottom, up the left
                self.rect(x + 5, y + size - 3, x + size, y + size - 1)
                self.rect(x + 2, y + 3, x + 4, y + size)
                self.arrow(x + 3, y + 4, 3.2, 0)

        else:                                     # double back
            self.rect(x + 2, y + 2, x + 4, y + 7)
            self.rect(x + 2, y + 2, x + size - 2, y + 4)
            self.rect(x + size - 4, y + 2, x + size - 2, y + size - 3)
            self.arrow(x + 3, y + size - 2, 3.2, 180)

    def line(self, start, end, thick=2):
        """A straight line of any angle, stamped in small steps."""
        (x0, y0), (x1, y1) = start, end
        steps = max(1, int(max(abs(x1 - x0), abs(y1 - y0))))
        for step in range(steps + 1):
            along = step / steps
            px = int(round(x0 + (x1 - x0) * along))
            py = int(round(y0 + (y1 - y0) * along))
            self.rect(px, py, px + thick, py + thick)

    def fill_triangle(self, points):
        """Fills the triangle between three (x, y) points, for arrow heads."""
        (x0, y0), (x1, y1), (x2, y2) = points
        left = int(math.floor(min(x0, x1, x2)))
        right = int(math.ceil(max(x0, x1, x2)))
        top = int(math.floor(min(y0, y1, y2)))
        bottom = int(math.ceil(max(y0, y1, y2)))

        def side(ax, ay, bx, by, px, py):
            return (bx - ax) * (py - ay) - (by - ay) * (px - ax)

        for py in range(top, bottom + 1):
            for px in range(left, right + 1):
                centre_x, centre_y = px + 0.5, py + 0.5
                signs = (side(x0, y0, x1, y1, centre_x, centre_y) < 0,
                         side(x1, y1, x2, y2, centre_x, centre_y) < 0,
                         side(x2, y2, x0, y0, centre_x, centre_y) < 0)
                if signs[0] == signs[1] == signs[2]:
                    self.rect(px, py, px + 1, py + 1)

    def frame_and_title(self, title):
        """The house style: a border, a title, and a rule under it."""
        width, height = g13lcd.VISIBLE_WIDTH, g13lcd.VISIBLE_HEIGHT
        self.rect(0, 0, width, 1)
        self.rect(0, height - 1, width, height)
        self.rect(0, 0, 1, height)
        self.rect(width - 1, 0, width, height)
        self.rect(1, 9, width - 1, 10)
        self.text(3, 2, title)

    def lines(self):
        lines = ["#bitmap " + g13lcd.pixels_to_frame(self.rows).hex()]
        for x, y, message in self.texts:
            lines.append("#text %d %d %s" % (x, y, message))
        return lines


class _Blank(dict):
    """Format values where a field that has no value yet reads as blank.

    A live value that is not there - the game not running, a file not written - should not
    put "?" on the screen; that is for a format that cannot be read at all.
    """

    def __missing__(self, key):
        return ""


