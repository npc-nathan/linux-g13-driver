class CustomVisual:
    name = "custom"
    title = "CUSTOM"
    interval = 1.0

    def render(self, screen, context):
        screen.frame_and_title(self.title)
        path = config_dir() / "screen.txt"
        try:
            lines = path.read_text().splitlines()
        except OSError:
            lines = []

        if not lines:
            screen.text(3, 18, "put text in")
            screen.text(3, 28, "screen.txt")
            return

        for index, line in enumerate(lines[:4]):
            screen.text(3, 12 + index * 8, line)

    def lines(self):
        # The visual's own name for the menu.
        return self.name


