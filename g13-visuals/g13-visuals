def config_dir():
    """The driver's config directory, honouring XDG_CONFIG_HOME."""
    base = os.environ.get("XDG_CONFIG_HOME")
    if base:
        return Path(base) / "g13"
    return Path(os.path.expanduser("~")) / ".config" / "g13"


def socket_path():
    """The driver's event socket."""
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if runtime:
        return Path(runtime) / "g13.sock"
    return Path("/tmp") / "g13.sock"


class Screen:
    """One 160x43 screen: pixels plus text drawn on top of them.

    Text cannot be drawn over filled pixels - the screen has one colour of ink - so the
    layout keeps text on blank areas and this class is just a description of what goes
    where. It becomes the driver's line protocol with lines().
    """

    def __init__(self):
        self.rows = g13lcd.blank()
        self.texts = []

    def text(self, x, y, message):
        self.texts.append((int(x), int(y), str(message)))

    def rect(self, x0, y0, x1, y1, value=1):
        g13lcd.draw_rect(self.rows, x0, y0, x1, y1, value)

    def bar(self, x, y, width, height, percent):
        g13lcd.draw_bar(self.rows, x, y, width, height, percent)

    def segments(self, x, y, width, height, count, percent, gap=1):
        """A gauge made of blocks rather than a solid bar.

        Easier to read at a glance when it is small, and it gives the screen its own look
        instead of a progress bar borrowed from a desktop. Blocks are lit from the left in
        proportion to the percentage; nothing is drawn for the unlit ones, so there is no
        hollow track for a value to sit on.
        """
        count = max(1, int(count))
        width, height = int(width), int(height)
        block = (width - (count - 1) * gap) // count
        if block < 1:
            block, count = 1, max(1, width)
        lit = int(round(count * max(0.0, min(100.0, float(percent))) / 100.0))
        for index in range(min(count, lit)):
            left = int(x) + index * (block + gap)
            self.rect(left, y, left + block, y + height)

    def brackets(self, x, y, width, height, length=6, thick=2):
        """Corner marks only: a frame round a widget without boxing it in."""
        x, y = int(x), int(y)
        right, bottom = x + int(width), y + int(height)
        left_arm, down_arm = min(length, width // 2), min(length, height // 2)

        self.rect(x, y, x + left_arm, y + thick)
        self.rect(x, y, x + thick, y + down_arm)
        self.rect(right - left_arm, y, right, y + thick)
        self.rect(right - thick, y, right, y + down_arm)
        self.rect(x, bottom - thick, x + left_arm, bottom)
        self.rect(x, bottom - down_arm, x + thick, bottom)
        self.rect(right - left_arm, bottom - thick, right, bottom)
        self.rect(right - thick, bottom - down_arm, right, bottom)

    def arrow(self, cx, cy, radius, angle_degrees, tail=0):
        """A filled arrow: 0 points up, 90 right, and so on clockwise.

        A bearing is the one thing a screen this size cannot say in words, so a HUD points
        at the next corner instead of describing it.
        """
        radius = max(2.0, float(radius))
        angle = math.radians(float(angle_degrees))
        sin, cos = math.sin(angle), math.cos(angle)

        def placed(px, py):
            return (cx + px * cos - py * sin, cy + px * sin + py * cos)

        if tail:
            self.line(placed(0, 0.7 * radius), placed(0, 0.7 * radius + float(tail)), 2)

        self.fill_triangle([placed(0, -radius),
                            placed(-0.62 * radius, 0.62 * radius),
                            placed(0.62 * radius, 0.62 * radius)])

        # The apex is a single point, so the rasterised triangle loses it when the arrow is
        # not on an axis (the tip stops a pixel short). Stamp the point itself.
        tip_x, tip_y = placed(0, -radius)
        tip_x, tip_y = int(round(tip_x)) - 1, int(round(tip_y)) - 1
        self.rect(tip_x, tip_y, tip_x + 2, tip_y + 2)

    def turn(self, x, y, angle_degrees, size=11):
        """A turn arrow: which way the next corner goes.

        Four shapes rather than a rotated arrow - at this size twenty degrees is one pixel,
        and a road-sign shape reads at a glance where a slight rotation does not.
        """
        x, y = int(x), int(y)
        size = int(size)
        angle = float(angle_degrees)
        magnitude = abs(angle)
        middle = x + size // 2

        if magnitude <= 20:                       # straight on
            self.rect(middle, y + 3, middle + 2, y + size)
            self.arrow(middle + 1, y + 4, 3.2, 0)

        elif magnitude <= 115:                    # left or right
            if angle > 0:                         # right: along the bottom, up the right
                self.rect(x, y + size - 3, x + size - 5, y + size - 1)
                self.rect(x + size - 5, y + 3, x + size - 3, y + size)
                self.arrow(x + size - 4, y + 4, 3.2, 0)
            else:                                 # left: along the bottom, up the left
                self.rect(x + 5, y + size - 3, x + size, y + size - 1)
                self.rect(x + 2, y + 3, x + 4, y + size)
                self.arrow(x + 3, y + 4, 3.2, 0)

        else:                                     # double back
            self.rect(x + 2, y + 2, x + 4, y + 7)
            self.rect(x + 2, y + 2, x + size - 2, y + 4)
            self.rect(x + size - 4, y + 2, x + size - 2, y + size - 3)
            self.arrow(x + 3, y + size - 2, 3.2, 180)

    def line(self, start, end, thick=2):
        """A straight line of any angle, stamped in small steps."""
        (x0, y0), (x1, y1) = start, end
        steps = max(1, int(max(abs(x1 - x0), abs(y1 - y0))))
        for step in range(steps + 1):
            along = step / steps
            px = int(round(x0 + (x1 - x0) * along))
            py = int(round(y0 + (y1 - y0) * along))
            self.rect(px, py, px + thick, py + thick)

    def fill_triangle(self, points):
        """Fills the triangle between three (x, y) points, for arrow heads."""
        (x0, y0), (x1, y1), (x2, y2) = points
        left = int(math.floor(min(x0, x1, x2)))
        right = int(math.ceil(max(x0, x1, x2)))
        top = int(math.floor(min(y0, y1, y2)))
        bottom = int(math.ceil(max(y0, y1, y2)))

        def side(ax, ay, bx, by, px, py):
            return (bx - ax) * (py - ay) - (by - ay) * (px - ax)

        for py in range(top, bottom + 1):
            for px in range(left, right + 1):
                centre_x, centre_y = px + 0.5, py + 0.5
                signs = (side(x0, y0, x1, y1, centre_x, centre_y) < 0,
                         side(x1, y1, x2, y2, centre_x, centre_y) < 0,
                         side(x2, y2, x0, y0, centre_x, centre_y) < 0)
                if signs[0] == signs[1] == signs[2]:
                    self.rect(px, py, px + 1, py + 1)

    def frame_and_title(self, title):
        """The house style: a border, a title, and a rule under it."""
        width, height = g13lcd.VISIBLE_WIDTH, g13lcd.VISIBLE_HEIGHT
        self.rect(0, 0, width, 1)
        self.rect(0, height - 1, width, height)
        self.rect(0, 0, 1, height)
        self.rect(width - 1, 0, width, height)
        self.rect(1, 9, width - 1, 10)
        self.text(3, 2, title)

    def lines(self):
        lines = ["#bitmap " + g13lcd.pixels_to_frame(self.rows).hex()]
        for x, y, message in self.texts:
            lines.append("#text %d %d %s" % (x, y, message))
        return lines


class _Blank(dict):
    """Format values where a field that has no value yet reads as blank.

    A live value that is not there - the game not running, a file not written - should not
    put "?" on the screen; that is for a format that cannot be read at all.
    """

    def __missing__(self, key):
        return ""


def centred(message, width=None):
    """Left padding that centres a string on the screen."""
    width = width or g13lcd.VISIBLE_WIDTH
    return max(0, (width - len(message) * 6) // 2)


def scrolling(message, widget, now=None):
    """A sliding window onto a long line, for text that does not fit.

    An objective is not twenty-five characters, and cutting it off loses the half that
    matters. The line wraps round with a gap between its end and its start, so a title that
    fits is left alone and one that does not is readable in a single pass.
    """
    window = int(widget.get("scroll_width", 25))
    speed = float(widget.get("scroll_speed", 3))
    if len(message) <= window:
        return message
    padded = message + "   "
    offset = int((time.time() if now is None else now) * speed) % len(padded)
    return (padded + padded)[offset:offset + window]


class ClockVisual:
    name = "clock"
    title = "CLOCK"
    interval = 1.0

    def render(self, screen, context):
        now = datetime.now()
        screen.frame_and_title(self.title)
        screen.text(centred(now.strftime("%H:%M:%S")), 17, now.strftime("%H:%M:%S"))
        screen.text(centred(now.strftime("%a %d %b %Y")), 29, now.strftime("%a %d %b %Y"))


class SystemVisual:
    name = "system"
    title = "SYSTEM"
    interval = 2.0

    def __init__(self):
        self.previous = None

    def cpu_percent(self):
        """Busy share of the cpu since the last look."""
        with open("/proc/stat") as handle:
            fields = [int(value) for value in handle.readline().split()[1:]]
        idle = fields[3] + fields[4]
        total = sum(fields)

        if self.previous is None:
            self.previous = (idle, total)
            return 0

        idle_delta = idle - self.previous[0]
        total_delta = total - self.previous[1]
        self.previous = (idle, total)
        if total_delta <= 0:
            return 0
        return int(100 * (total_delta - idle_delta) / total_delta)

    def memory_percent(self):
        values = {}
        with open("/proc/meminfo") as handle:
            for line in handle:
                key, _, rest = line.partition(":")
                values[key] = int(rest.split()[0])
        total = values.get("MemTotal", 1)
        available = values.get("MemAvailable", 0)
        return int(100 * (total - available) / total)

    def render(self, screen, context):
        usage = self.cpu_percent()
        memory = self.memory_percent()
        with open("/proc/loadavg") as handle:
            load = float(handle.read().split()[0])
        with open("/proc/uptime") as handle:
            uptime = float(handle.read().split()[0])

        screen.frame_and_title(self.title)
        for row, (label, percent) in enumerate((("CPU", usage), ("MEM", memory))):
            y = 12 + row * 10
            screen.text(3, y, label)
            screen.bar(28, y, 88, 8, percent)
            screen.text(122, y, "%3d%%" % percent)

        hours = int(uptime // 3600)
        screen.text(3, 33, "LOAD %.2f   UP %dh%02dm" % (load, hours, int(uptime % 3600) // 60))


class MediaVisual:
    name = "media"
    title = "MEDIA"
    interval = 1.0

    def metadata(self):
        """What the running media player reports, or None."""
        try:
            result = subprocess.run(
                ["playerctl", "metadata", "--format",
                 "{{status}}|{{artist}}|{{title}}|{{position}}|{{mpris:length}}"],
                capture_output=True, text=True, timeout=0.5)
        except (OSError, subprocess.SubprocessError):
            return None

        if result.returncode != 0 or not result.stdout.strip():
            return None
        parts = (result.stdout.strip().split("|") + [""] * 5)[:5]
        return parts

    def render(self, screen, context):
        screen.frame_and_title(self.title)
        data = self.metadata()

        if data is None:
            screen.text(centred("no player"), 18, "no player")
            return

        status, artist, title, position, length = data
        playing = "playing" if status == "Playing" else status.lower() or "stopped"
        screen.text(3, 12, (title or "unknown")[:24])
        screen.text(3, 21, (artist or "")[:24])

        try:
            done = int(position) // 1_000_000
            total = int(length) // 1_000_000
        except (TypeError, ValueError):
            done, total = 0, 0

        percent = int(100 * done / total) if total else 0
        screen.bar(3, 32, 110, 8, percent)
        screen.text(118, 32, ("%d:%02d" % (done // 60, done % 60)) if total else playing)


class PadVisual:
    name = "pad"
    title = "PAD"
    interval = 1.0

    def render(self, screen, context):
        screen.frame_and_title(self.title)
        profile = context.get("profile", 0)
        screen.text(3, 12, "PROFILE M%d" % (profile + 1))

        recording = "RECORDING" if context.get("recording") else "idle"
        screen.text(3, 21, "MR: %s" % recording)

        recent = context.get("recent", [])
        screen.text(3, 31, " ".join(recent[-6:]) or "-")


class CustomVisual:
    name = "custom"
    title = "CUSTOM"
    interval = 1.0

    def render(self, screen, context):
        screen.frame_and_title(self.title)
        path = config_dir() / "screen.txt"
        try:
            lines = path.read_text().splitlines()
        except OSError:
            lines = []

        if not lines:
            screen.text(3, 18, "put text in")
            screen.text(3, 28, "screen.txt")
            return

        for index, line in enumerate(lines[:4]):
            screen.text(3, 12 + index * 8, line)

    def lines(self):
        # The visual's own name for the menu.
        return self.name


VISUALS = [ClockVisual(), SystemVisual(), MediaVisual(), PadVisual(), CustomVisual()]
VISUALS_BY_NAME = {visual.name: visual for visual in VISUALS}

APPLET_PREFIX = "applet:"

# --- data a designed applet can show ---


def shell(command, timeout=0.4):
    """Runs a command for its output, or None if it fails or takes too long."""
    try:
        result = subprocess.run(command, shell=True, capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.SubprocessError):
        return None
    if result.returncode != 0:
        return None
    return result.stdout.strip()


class Values:
    """The live numbers and strings an applet can put on the screen.

    Sources are named in the applet's JSON: a plain name (cpu, memory, time, ...), or
    file:<path>, cmd:<shell command> and env:<name> for anything else. Expensive ones are
    cached for a short while, because a visual redraws every second or so and shelling out
    that often for a clock would be silly.
    """

    CACHE_SECONDS = 2.0
    #: Live sources are read far more often: a game's HUD should not lag a quarter of a
    #: second behind the game because of a cache meant for clocks.
    LIVE_CACHE_SECONDS = 0.2

    def __init__(self, clock=time.monotonic):
        self.clock = clock
        self.cache = {}
        self.cpu_previous = None
        self.context = {}

    def set_context(self, **context):
        """State the driver told us about: recording, profile, recent presses."""
        self.context.update(context)

    def cpu_percent(self):
        with open("/proc/stat") as handle:
            fields = [int(value) for value in handle.readline().split()[1:]]
        idle = fields[3] + fields[4]
        total = sum(fields)
        if self.cpu_previous is None:
            self.cpu_previous = (idle, total)
            return 0.0
        idle_delta = idle - self.cpu_previous[0]
        total_delta = total - self.cpu_previous[1]
        self.cpu_previous = (idle, total)
        if total_delta <= 0:
            return 0.0
        return 100.0 * (total_delta - idle_delta) / total_delta

    def memory_percent(self):
        values = {}
        with open("/proc/meminfo") as handle:
            for line in handle:
                key, _, rest = line.partition(":")
                values[key] = int(rest.split()[0])
        total = values.get("MemTotal", 1)
        return 100.0 * (total - values.get("MemAvailable", 0)) / total

    def uptime_seconds(self):
        with open("/proc/uptime") as handle:
            return float(handle.read().split()[0])

    def media(self):
        line = shell("playerctl metadata --format '{{status}}|{{artist}}|{{title}}|"
                     "{{position}}|{{mpris:length}}'") if self.which("playerctl") else None
        parts = (line.split("|") + [""] * 5)[:5] if line else ["", "", "", "", ""]
        duration = 0
        try:
            duration = int(parts[4]) // 1_000_000
        except ValueError:
            pass
        return parts, duration

    @staticmethod
    def which(program):
        return any(os.access(os.path.join(path, program), os.X_OK)
                   for path in os.environ.get("PATH", "").split(os.pathsep))

    def raw(self, source):
        now = self.clock()
        cached = self.cache.get(source)
        seconds = (self.LIVE_CACHE_SECONDS if source.startswith(("json:", "file:"))
                   else self.CACHE_SECONDS)
        if cached and now - cached[0] < seconds:
            return cached[1]

        value = self.resolve(source)
        self.cache[source] = (now, value)
        return value

    def resolve(self, source):
        now = datetime.now()
        uptime = self.uptime_seconds()
        media, duration = self.media()
        position = 0
        try:
            position = int(media[3]) // 1_000_000
        except ValueError:
            pass

        built_in = {
            "cpu": self.cpu_percent,
            "memory": self.memory_percent,
            "load": lambda: float(open("/proc/loadavg").read().split()[0]),
            "uptime": lambda: "%dh%02dm" % (int(uptime // 3600), int(uptime % 3600) // 60),
            "uptime_seconds": lambda: uptime,
            "time": lambda: now.strftime("%H:%M"),
            "time_seconds": lambda: now.strftime("%H:%M:%S"),
            "date": lambda: now.strftime("%d/%m/%Y"),
            "day": lambda: now.strftime("%a"),
            "media_status": lambda: media[0],
            "media_artist": lambda: media[1],
            "media_title": lambda: media[2],
            "media_position": lambda: "%d:%02d" % (position // 60, position % 60),
            "media_duration": lambda: "%d:%02d" % (duration // 60, duration % 60),
            "media_percent": lambda: (100.0 * position / duration) if duration else 0.0,
            "profile": lambda: "M%d" % (int(self.context.get("profile", 0)) + 1),
            "recording": lambda: "yes" if self.context.get("recording") else "no",
            "last_key": lambda: (self.context.get("recent") or ["-"])[-1],
            "recent_keys": lambda: " ".join(self.context.get("recent", [])),
            "screen_width": lambda: g13lcd.VISIBLE_WIDTH,
            "screen_height": lambda: g13lcd.VISIBLE_HEIGHT,
        }

        if source in built_in:
            return built_in[source]()

        if source.startswith("env:"):
            return os.environ.get(source[4:], "")

        if source.startswith("file:"):
            try:
                with open(os.path.expanduser(source[5:])) as handle:
                    return handle.readline().strip()
            except OSError:
                return ""

        if source.startswith("json:"):
            return self.json_field(source[5:])

        if source.startswith("cmd:"):
            return shell(source[4:]) or ""

        return ""

    def json_field(self, spec):
        """One field of a JSON file: `json:<path>#<field>`, e.g. json:/tmp/hud.json#ammo.

        This is how a game feeds the screen: it writes a small JSON file and the applet
        reads the fields it wants. Nested fields are dotted (`#hud.ammo`) and a list index
        is a number (`#route.0`). With no field the whole file is a value only if it is a
        single number, string or boolean. A missing file, unreadable JSON, missing field or
        wrong type all read as an empty string - a game that is not running must leave the
        screen blank, not take the daemon down.
        """
        path, separator, field = spec.rpartition("#")
        if not separator:
            path, field = spec, ""

        try:
            with open(os.path.expanduser(path)) as handle:
                data = json.load(handle)
        except (OSError, ValueError):
            return ""

        if not field:
            return data if isinstance(data, (int, float, str, bool)) else ""

        for part in field.split("."):
            if isinstance(data, dict) and part in data:
                data = data[part]
            elif isinstance(data, list) and part.lstrip("-").isdigit():
                index = int(part)
                data = data[index] if -len(data) <= index < len(data) else ""
            else:
                return ""

        return data if isinstance(data, (int, float, str, bool)) else ""

    def all(self, sources):
        """Resolves several sources at once, for the values file."""
        return {source: self.raw(source) for source in sources}


class LayoutVisual:
    """A visual described by JSON rather than by code: the applet designer's output.

    Widgets are placed on the screen and bound to data::

        {"name": "stats", "title": "STATS", "interval": 1,
         "widgets": [
            {"type": "text", "x": 3, "y": 12, "format": "CPU {cpu:.0f}%"},
            {"type": "bar",  "x": 28, "y": 12, "w": 88, "h": 8, "source": "cpu", "max": 100},
            {"type": "line", "x": 1, "y": 30, "w": 158},
            {"type": "box",  "x": 1, "y": 18, "w": 158, "h": 10}]}

    `format` is a str.format template over every value (so one label can show several), and
    `source` is the single value a bar uses.
    """

    def __init__(self, definition, values):
        self.definition = definition
        self.values = values
        self.name = APPLET_PREFIX + str(definition.get("name", "applet"))
        self.interval = float(definition.get("interval", 1.0))
        #: Short names for data sources, so a widget can say {"source": "ammo"} and a
        #: format can say {ammo} instead of repeating a path in full:
        #: "sources": {"ammo": "json:~/hud.json#ammo"}
        self.aliases = {str(key): str(value) for key, value in
                        (definition.get("sources") or {}).items()}

    @property
    def title(self):
        return str(self.definition.get("title", self.definition.get("name", "APPLET")))

    def spec_of(self, name):
        """The real source an applet's short name stands for, following aliases."""
        for _step in range(8):
            if name not in self.aliases:
                break
            name = self.aliases[name]
        return name

    def asked_names(self):
        """The names the applet mentions: widget sources and format fields."""
        wanted = set()
        for widget in self.definition.get("widgets", []):
            if widget.get("source"):
                wanted.add(str(widget["source"]))
            for _literal, field, _spec, _conversion in string.Formatter().parse(
                    widget.get("format") or ""):
                if field:
                    wanted.add(field.split(".")[0].split("[")[0])
        return sorted(wanted)

    def sources(self):
        """Every data source this applet asks for, as the specs to actually read."""
        return sorted({self.spec_of(name) for name in self.asked_names()})

    def value_of(self, source):
        if source is None:
            return ""
        return self.values.raw(self.spec_of(str(source)))

    def render(self, screen, context):
        border = self.definition.get("border", True)
        if border:
            screen.frame_and_title(self.title)
        values = self.values.all(self.sources())
        # The applet's own short names work in formats too, so {ammo} can stand for a path.
        for name in self.asked_names():
            spec = self.spec_of(name)
            if spec in values:
                values[name] = values[spec]

        for widget in self.definition.get("widgets", []):
            kind = widget.get("type", "text")
            x = int(widget.get("x", 0))
            y = int(widget.get("y", 0))

            if kind == "text":
                template = widget.get("format")
                if template is None:
                    message = str(self.value_of(widget.get("source")))
                else:
                    # A field with no value yet - the game is not running, the file has not
                    # been written - reads as blank. "?" is kept for a format that cannot be
                    # read at all, which is a mistake in the applet rather than missing data.
                    try:
                        message = template.format_map(_Blank(values))
                    except (ValueError, IndexError):
                        message = "?"

                # A long line - an objective, a track title - slides along rather than
                # being cut off at the edge.
                if widget.get("scroll"):
                    message = scrolling(message, widget)

                # Alignment is computed from the text, so a design can pin a value to the
                # right edge without knowing how wide the number will be.
                align = widget.get("align")
                margin = int(widget.get("margin", 3))
                if align == "centre":
                    x = centred(message)
                elif align == "right":
                    x = max(0, g13lcd.VISIBLE_WIDTH - margin - len(message) * 6)
                screen.text(x, y, message)

            elif kind == "bar":
                top = float(widget.get("max", 100)) or 100
                try:
                    percent = 100.0 * float(self.value_of(widget.get("source"))) / top
                except (TypeError, ValueError):
                    percent = 0
                screen.bar(x, y, int(widget.get("w", 88)), int(widget.get("h", 8)), percent)

            elif kind == "line":
                screen.rect(x, y, x + int(widget.get("w", 158)), y + 1)

            elif kind == "box":
                screen.rect(x, y, x + int(widget.get("w", 158)), y + int(widget.get("h", 10)))

            elif kind == "segments":
                top = float(widget.get("max", 100)) or 100
                try:
                    percent = 100.0 * float(self.value_of(widget.get("source"))) / top
                except (TypeError, ValueError):
                    percent = 0
                screen.segments(x, y, int(widget.get("w", 88)), int(widget.get("h", 6)),
                                int(widget.get("count", 12)), percent)

            elif kind == "brackets":
                screen.brackets(x, y, int(widget.get("w", 158)), int(widget.get("h", 10)),
                                int(widget.get("len", 6)), int(widget.get("thick", 2)))

            elif kind == "arrow":
                screen.arrow(x, y, float(widget.get("r", 8)), self.angle_of(widget))

            elif kind == "turn":
                screen.turn(x, y, self.angle_of(widget), int(widget.get("size", 11)))

            elif kind == "vline":
                screen.rect(x, y, x + 1, y + int(widget.get("h", 10)))

    def angle_of(self, widget):
        """The angle a directional widget points at, read from its source.

        A game that is not running gives no value, and no direction is the right answer
        then, so the arrow points up rather than the applet falling over.
        """
        try:
            return float(self.value_of(widget.get("source")))
        except (TypeError, ValueError):
            return 0.0


def applet_dir():
    return config_dir() / "applets"


def load_applets(values):
    """Every designed applet in the applets directory, newest content each call."""
    applets = {}
    directory = applet_dir()
    if not directory.is_dir():
        return applets

    for path in sorted(directory.glob("*.json")):
        try:
            definition = json.loads(path.read_text())
        except (OSError, ValueError) as error:
            print("skipping %s: %s" % (path, error), file=sys.stderr)
            continue
        definition.setdefault("name", path.stem)
        visual = LayoutVisual(definition, values)
        applets[visual.name] = visual
    return applets


def registry(values):
    """The built-in visuals plus every designed applet."""
    visuals = {visual.name: visual for visual in VISUALS}
    visuals.update(load_applets(values))
    return visuals


class Engine:
    """Turns button presses into a screen.

    Kept free of sockets and timers so it can be driven directly in tests.
    """

    def __init__(self, config=None, clock=time.monotonic, visuals=None, values=None):
        self.clock = clock
        self.values = values
        self.visuals = visuals if visuals is not None else {item.name: item for item in VISUALS}
        self.config = config or {}
        available = list(self.visuals)
        self.enabled = [name for name in self.config.get("enabled", available)
                        if name in self.visuals] or available[:1]
        self.active = self.config.get("active", self.enabled[0])
        if self.active not in self.visuals:
            self.active = self.enabled[0]
        self.cycle = bool(self.config.get("cycle", False))
        self.cycle_seconds = float(self.config.get("cycle_seconds", 10))

        self.menu_open = False
        self.menu_index = 0
        self.recent = []
        self.recording = False
        self.profile = 0

        self.menu_button_pressed_at = None
        self.last_cycle_at = clock()

    # --- configuration ---

    def snapshot(self):
        """The part of the state that belongs in the config file."""
        return {
            "enabled": self.enabled,
            "active": self.active,
            "cycle": self.cycle,
            "cycle_seconds": self.cycle_seconds,
        }

    # --- what is on the menu ---

    def menu_items(self):
        items = [("cycle", "Auto-cycle: %s" % ("on" if self.cycle else "off"))]
        for name in self.enabled:
            title = getattr(self.visuals[name], "title", name)
            items.append((name, str(title)[:24]))
        return items

    def switch_to(self, name):
        if name in self.visuals:
            self.active = name
            self.last_cycle_at = self.clock()

    def next_visual(self):
        if self.active in self.enabled:
            index = self.enabled.index(self.active)
        else:
            index = -1
        self.switch_to(self.enabled[(index + 1) % len(self.enabled)])

    # --- events ---

    def on_key(self, code, pressed):
        """Handles one physical key change from the pad."""
        if pressed:
            self.recent.append(KEY_NAMES.get(code, "code %d" % code))
            self.recent = self.recent[-6:]

        if code == MENU_BUTTON:
            self.on_menu_button(pressed)
            return

        if not self.menu_open or not pressed:
            return

        if code == BUTTON_UP:
            self.menu_index = (self.menu_index - 1) % len(self.menu_items())
        elif code == BUTTON_DOWN:
            self.menu_index = (self.menu_index + 1) % len(self.menu_items())
        elif code == BUTTON_SELECT:
            self.select_menu_item()
        elif code == BUTTON_BACK:
            self.menu_open = False

    def on_menu_button(self, pressed):
        """G24: a tap moves on, holding it opens the menu."""
        now = self.clock()
        if pressed:
            self.menu_button_pressed_at = now
            return

        held_for = now - self.menu_button_pressed_at if self.menu_button_pressed_at else 0
        self.menu_button_pressed_at = None

        if held_for >= LONG_PRESS_SECONDS:
            self.menu_open = not self.menu_open
            self.menu_index = 0
        elif self.menu_open:
            self.menu_open = False
        else:
            self.next_visual()

    def select_menu_item(self):
        key, _label = self.menu_items()[self.menu_index]
        if key == "cycle":
            self.cycle = not self.cycle
        else:
            self.switch_to(key)
            self.menu_open = False
        self.menu_index = 0

    def on_state(self, what, value):
        """State the driver broadcasts, e.g. recording starting."""
        if what == "recording":
            self.recording = bool(value)
        elif what == "profile":
            self.profile = int(value)

    # --- output ---

    def tick(self):
        """Returns the lines to draw, or None when nothing needs redrawing."""
        now = self.clock()
        if self.cycle and not self.menu_open and now - self.last_cycle_at >= self.cycle_seconds:
            self.next_visual()

        screen = Screen()
        context = {
            "recording": self.recording,
            "profile": self.profile,
            "recent": self.recent,
        }
        if self.values is not None:
            self.values.set_context(**context)

        if self.menu_open:
            self.render_menu(screen)
        else:
            self.visuals[self.active].render(screen, context)
        return screen.lines()

    def render_menu(self, screen):
        """A vertical menu, four rows at a time, scrolling with the selection."""
        items = self.menu_items()
        per_page = 4

        screen.rect(0, 0, g13lcd.VISIBLE_WIDTH, 1)
        screen.text(3, 1, "VISUALS")

        # Keep the selection on screen when there are more items than fit.
        first = 0
        if len(items) > per_page:
            first = max(0, min(self.menu_index - per_page // 2, len(items) - per_page))

        for row, (_key, label) in enumerate(items[first:first + per_page]):
            index = first + row
            y = 11 + row * 8
            if index == self.menu_index:
                # The screen has one colour of ink, so a selection cannot be a filled
                # row with text on it - the text would disappear into it. A marker bar
                # beside the label and a line underneath say the same thing and leave
                # the pixels the text needs blank.
                screen.rect(2, y, 5, y + 7)
                screen.rect(8, y + 7, g13lcd.VISIBLE_WIDTH - 3, y + 8)
            screen.text(9, y, label[:24])

    def interval(self):
        """How long until this visual needs redrawing."""
        return 1.0 if self.menu_open else self.visuals[self.active].interval


def read_config():
    path = config_dir() / "visuals.json"
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return {}


def write_config(snapshot):
    path = config_dir() / "visuals.json"
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps(snapshot, indent=2) + "\n")
    except OSError as error:
        print("could not save %s: %s" % (path, error), file=sys.stderr)


PUBLISHED_SOURCES = [
    "cpu", "memory", "load", "uptime", "uptime_seconds", "time", "time_seconds", "date",
    "day", "media_status", "media_artist", "media_title", "media_position",
    "media_duration", "media_percent", "profile", "recording", "last_key", "recent_keys",
    "screen_width", "screen_height",
]

# Who owns the screen and the four buttons beside it. Logitech's own software rotated between
# applets; here it is one or the other, chosen by whoever is using the pad.
BUTTON_MODE_FILE = "button-mode"
BUTTON_MODES = ("auto", "visuals", "sdk")

# Our Logitech LCD SDK implementation touches this while it is drawing, and the Windows
# bridge keeps it fresh while a client is connected.
SDK_CLIENT_FILE = "g13-sdk-client"
SDK_CLIENT_FRESH_SECONDS = 3.0


def runtime_path(name):
    runtime = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
    return os.path.join(runtime, name)


def button_mode():
    """'auto', 'visuals' or 'sdk' - read from the file the tool and the CLI write."""
    try:
        mode = (config_dir() / BUTTON_MODE_FILE).read_text().strip().lower()
    except OSError:
        return "auto"
    return mode if mode in BUTTON_MODES else "auto"


def set_button_mode(mode):
    path = config_dir() / BUTTON_MODE_FILE
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(mode.strip().lower() + "\n")


def sdk_client_present(now=None, runtime=None):
    """Whether a Logitech-LCD-SDK client - a game, an applet, the Windows bridge - is drawing.

    A file that has gone stale means the client died without shutting down, so it counts as
    gone: otherwise one crash would leave the pad deaf to its own buttons for good.
    """
    moment = time.time() if now is None else now
    path = os.path.join(runtime or runtime_path(""), SDK_CLIENT_FILE)
    try:
        return moment - os.stat(path).st_mtime <= SDK_CLIENT_FRESH_SECONDS
    except OSError:
        return False


def should_pause(mode, client_present):
    """Whether the visuals should keep their hands off the screen and the four buttons.

    auto    - yes while an SDK client is connected, no when it is not
    visuals - never: the menu keeps the screen and the buttons
    sdk     - always: an SDK client owns them whether or not one is connected
    """
    if mode == "sdk":
        return True
    if mode == "visuals":
        return False
    return bool(client_present)


def screen_state(mode, client_present, paused):
    """A few extra values, so the config tool can say who has the screen."""
    return {"button_mode": mode, "sdk_client": client_present,
            "screen_owner": "sdk" if paused else "visuals"}


def publish_values(values):
    """The live values on their own, for when the screen is not ours to draw."""
    try:
        with open(runtime_path("g13-values.json"), "w") as handle:
            json.dump(values, handle, indent=2, sort_keys=True)
    except OSError:
        pass


def publish(lines, values):
    """Publishes what is on the screen, and the live values, for the config tool.

    The tool cannot read the panel, so this is how its preview shows the real thing and
    how the applet designer previews a design against live data.
    """
    try:
        with open(runtime_path("g13-screen"), "w") as handle:
            handle.write("\n".join(lines) + "\n")
    except OSError:
        pass
    publish_values(values)


def config_supersedes(engine, fresh):
    """Whether a freshly read config file should replace the running engine.

    The file is the shared truth - which visuals exist, the order, the cycle settings, and
    which one is showing. The daemon writes its own changes (G24, the menu) back into that
    same file, so adopting it never fights the device. An earlier version kept the running
    visual whenever it was still enabled, which quietly made a change made anywhere else -
    the config tool's "Show now" - do nothing at all.
    """
    return (fresh.active != engine.active
            or fresh.snapshot() != engine.snapshot()
            or set(fresh.visuals) != set(engine.visuals))


def main():
    values = Values()
    visuals = registry(values)
    engine = Engine(read_config(), visuals=visuals, values=values)

    config_stamp = None
    last_poll = 0.0
    last_drawn = 0.0
    dirty = True
    shown_state = None

    while True:
        # --- the driver's event socket, reconnecting as needed ---
        try:
            connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            connection.settimeout(0.2)
            connection.connect(str(socket_path()))
        except OSError:
            time.sleep(RECONNECT_SECONDS)
            last_poll = 0.0
            continue

        print("g13-visuals: connected to %s, showing '%s'" % (socket_path(), engine.active), flush=True)
        pending = b""
        paused = None
        last_state_published = 0.0

        while True:
            # Who has the screen and the four buttons beside it. A mode the user set, and
            # whether an SDK client is actually drawing.
            mode = button_mode()
            client_present = sdk_client_present()
            pause = should_pause(mode, client_present)
            if pause != paused:
                paused = pause
                print("g13-visuals: %s" % (
                    "an SDK client has the screen and the four buttons ('%s')" % mode
                    if pause else
                    "the visuals have the screen and the four buttons ('%s')" % mode),
                    flush=True)

            try:
                chunk = connection.recv(4096)
            except socket.timeout:
                chunk = None
            except OSError:
                chunk = b""

            if chunk == b"":
                break  # Driver went away; reconnect.

            if chunk:
                pending += chunk
                while b"\n" in pending:
                    line, pending = pending.split(b"\n", 1)
                    fields = line.decode(errors="replace").split()
                    if len(fields) >= 3 and fields[0] == "key":
                        # While an SDK client owns the buttons, they are its input to read.
                        if not paused:
                            engine.on_key(int(fields[1]), fields[2] != "0")
                        dirty = True
                    elif len(fields) >= 3 and fields[0] == "state":
                        engine.on_state(fields[1], fields[2])
                        dirty = True

            now = time.monotonic()

            # --- pick up applets and config changes made elsewhere (the config tool) ---
            if now - last_poll >= CONFIG_POLL_SECONDS:
                last_poll = now
                path = config_dir() / "visuals.json"
                try:
                    stamp = path.stat().st_mtime
                except OSError:
                    stamp = None

                if stamp != config_stamp:
                    config_stamp = stamp
                    fresh_visuals = registry(values)
                    fresh = Engine(read_config(), clock=engine.clock,
                                   visuals=fresh_visuals, values=values)
                    # The file is the shared truth, including which visual is showing.
                    if config_supersedes(engine, fresh):
                        engine = fresh
                        dirty = True

            # --- draw when the visual asks for it, or straight after a button ---
            if not paused and (dirty or now - last_drawn >= engine.interval()):
                lines = engine.tick()
                g13lcd.send(lines)

                sources = list(PUBLISHED_SOURCES)
                active = engine.visuals.get(engine.active)
                if isinstance(active, LayoutVisual):
                    sources += [source for source in active.sources()
                                if not source.startswith("cmd:")]
                published = values.all(sources)
                published.update(screen_state(mode, client_present, False))
                publish(lines, published)

                last_drawn = now
                if shown_state != engine.snapshot():
                    shown_state = engine.snapshot()
                    write_config(shown_state)
                dirty = False

            elif paused and now - last_state_published >= 1.0:
                # Keep the values current while an SDK client has the screen: the tool shows
                # who owns it from these, and a stale file would say the wrong thing.
                last_state_published = now
                state = values.all(PUBLISHED_SOURCES)
                state.update(screen_state(mode, client_present, True))
                publish_values(state)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
