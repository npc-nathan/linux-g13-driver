def number_or(value, default):
    """A number from a hand-written JSON file, or the default if it is not one.

    Applets are files people edit by hand, so a wrong type is an ordinary mistake rather than a
    reason to fail: the daemon keeps drawing with the default, and `g13-applet check` is what
    tells the author about it.
    """
    if value is None or isinstance(value, bool):
        return default
    if isinstance(value, (int, float)):
        return value
    try:
        return float(value)
    except (TypeError, ValueError):
        return default


def text_problems(lines, width=None, height=None):
    """Everything wrong with the text in one drawn screen, as the driver would see it.

    The panel has one colour of ink and text is drawn over the pixels, so text that lands on a
    filled pixel is invisible; text below the visible rows, or running past the right edge, never
    shows either. `lines` is the driver's protocol - the `#bitmap` frame and the `#text` lines
    after it - so what is checked is what would actually be sent to the pad.

    Shared on purpose: the tool's preview, `g13-applet check` and the test suite use this one
    rule rather than each having an opinion. It used to live in the test suite alone.
    """
    width = g13lcd.VISIBLE_WIDTH if width is None else width
    height = g13lcd.VISIBLE_HEIGHT if height is None else height
    if not lines:
        return ["nothing was drawn"]
    if not lines[0].startswith("#bitmap "):
        return ["the first line is not a frame: %r" % str(lines[0])[:40]]
    try:
        frame = bytes.fromhex(lines[0].split(" ", 1)[1])
    except ValueError:
        return ["the frame is not hex"]

    problems = []
    for line in lines[1:]:
        parts = line.split(" ", 3)
        if parts[0] != "#text" or len(parts) < 3:
            continue
        x, y = int(parts[1]), int(parts[2])
        message = parts[3] if len(parts) > 3 else ""
        if y < 0 or y + g13lcd.TEXT_HEIGHT > height:
            problems.append("text off the visible screen: %r at y=%d" % (message, y))
        if x < 0 or x + len(message) * g13lcd.CHAR_WIDTH > width:
            problems.append("text off the visible screen: %r runs to x=%d"
                            % (message, x + len(message) * g13lcd.CHAR_WIDTH))
        for column in range(max(0, x), min(width, x + len(message) * g13lcd.CHAR_WIDTH)):
            for row in range(max(0, y), min(height, y + g13lcd.TEXT_HEIGHT)):
                index = column + (row // 8) * g13lcd.WIDTH
                if index < len(frame) and frame[index] & (1 << (row % 8)):
                    problems.append("%r overlaps filled pixels at (%d,%d)" % (message, column, row))
    return problems


def layout_problems(visual, context=None):
    """The same check for one visual: draw it, and look at what came out."""
    screen = Screen()
    visual.render(screen, context or {})
    return text_problems(screen.lines())


def centred(message, width=None):
    """Left padding that centres a string on the screen."""
    width = width or g13lcd.VISIBLE_WIDTH
    return max(0, (width - len(message) * 6) // 2)


def scrolling(message, widget, now=None):
    """A sliding window onto a long line, for text that does not fit.

    An objective is not twenty-five characters, and cutting it off loses the half that
    matters. The line wraps round with a gap between its end and its start, so a title that
    fits is left alone and one that does not is readable in a single pass.
    """
    window = int(number_or(widget.get("scroll_width"), 25)) or 25
    speed = float(number_or(widget.get("scroll_speed"), 3))
    if len(message) <= window:
        return message
    padded = message + "   "
    offset = int((time.time() if now is None else now) * speed) % len(padded)
    return (padded + padded)[offset:offset + window]


