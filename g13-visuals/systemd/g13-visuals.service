[Unit]
Description=G13 screen visuals (applets and menu)
Documentation=https://github.com/Lordbooker/linux-g13-driver
After=g13.service
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/env python3 %h/.local/bin/g13-visuals
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
